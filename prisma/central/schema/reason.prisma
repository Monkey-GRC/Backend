model Reason {
    id              String    @id @default(uuid()) @db.Uuid
    name            String
    description     String?
    code            String    @unique @db.VarChar(10)
    seq             Int      @unique @default(autoincrement())
    created_at      DateTime  @default(now())
    updated_at      DateTime  @updatedAt
    created_by      String?   @db.Uuid
    created_by_user User?     @relation("mnk_user_created_reasons", fields: [created_by], references: [id], onDelete: NoAction)
    updated_by      String?   @db.Uuid
    updated_by_user User?     @relation("mnk_user_updated_reasons", fields: [updated_by], references: [id], onDelete: NoAction)
    risks           RiskReason[]
    controls        ReasonControl[]

    @@map("mnk_reasons")
    @@index([seq])
    @@index([code])
}

model RiskReason {
    id        String @id @default(uuid()) @db.Uuid
    risk_id   String @db.Uuid
    risk      Risk   @relation(fields: [risk_id], references: [id], onDelete: Cascade)
    reason_id String @db.Uuid
    reason    Reason @relation(fields: [reason_id], references: [id], onDelete: Cascade)

    created_at DateTime @default(now())

    @@map("mnk_risk_reasons")
    @@unique([risk_id, reason_id])
}

model ReasonControl {
    id         String  @id @default(uuid()) @db.Uuid
    reason_id  String  @db.Uuid
    reason     Reason  @relation(fields: [reason_id], references: [id], onDelete: Cascade)
    control_id String  @db.Uuid
    control    Control @relation(fields: [control_id], references: [id], onDelete: Cascade)

    created_at DateTime @default(now())

    @@map("mnk_reason_controls")
    @@unique([reason_id, control_id])
}

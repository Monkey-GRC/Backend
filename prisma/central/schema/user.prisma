enum Role {
  CLIENT_ADMIN
  USER
  VIEWER
  MONKEY_ADMIN
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  password   String
  name       String?
  last_name  String?
  username   String   @unique
  role       Role     @default(MONKEY_ADMIN)
  seq        Int      @unique @default(autoincrement())
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String?
  updated_by String?

  refresh_token_hash       String?   @db.Text
  refresh_token_expires_at DateTime?


  created_reasons Reason[] @relation("mnk_user_created_reasons")
  updated_reasons Reason[] @relation("mnk_user_updated_reasons")

  created_risks Risk[] @relation("mnk_user_created_risks")
  updated_risks Risk[] @relation("mnk_user_updated_risks")

  created_controls Control[] @relation("mnk_user_created_controls")
  updated_controls Control[] @relation("mnk_user_updated_controls")

  created_manual_checks   ManualCheckItem[]     @relation("mnk_user_created_manual_checks")
  evaluated_manual_checks ManualCheckItem[]     @relation("mnk_user_evaluated_manual_checks")
  uploaded_manual_check_evidence ManualCheckEvidence[] @relation("mnk_user_uploaded_manual_check_evidence")

  created_assets Asset[] @relation("mnk_user_created_assets")
  updated_assets Asset[] @relation("mnk_user_updated_assets")

  @@map("mnk_users")

  @@index([email])
  @@index([username])
  @@index([seq])

}

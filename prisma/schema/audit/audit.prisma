enum AuditResult {
  success
  error

  @@map("audit_result")

  @@schema("audit")
}

// Acciones sobre la plataforma: quién cambió qué en el sistema.
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  // Nullable: acciones de admin_monkey a nivel plataforma (p. ej. crear una empresa)
  // ocurren antes de que exista un tenant al cual atribuirlas.
  tenantId    String?     @map("tenant_id") @db.Uuid
  // Nullable: un intento de login con un email que no existe (CC7.2) no tiene usuario
  // al cual atribuirlo; en ese caso queda `attemptedEmail`.
  userId      String?     @map("user_id") @db.Uuid
  attemptedEmail String?  @map("attempted_email")
  action      String
  resource    String
  beforeState Json?       @map("before_state")
  afterState  Json?       @map("after_state")
  ipAddress   String      @map("ip_address")
  userAgent   String      @map("user_agent")
  result      AuditResult
  createdAt   DateTime    @default(now()) @map("created_at")

  // `user_id` sin clave foránea (D117): el audit trail no se reescribe y la cuenta de un admin_monkey puede purgarse; el nombre sale del sello (admin_tombstones).
  tenant Company? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
  @@schema("audit")
}

// Cambios en el estado de cumplimiento (distinto de audit_logs).
model ComplianceEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  // Nulo = lo cambió el sistema, sin una persona detrás (la sonda al escribir un resultado, D91).
  userId        String?  @map("user_id") @db.Uuid
  changedField  String   @map("changed_field")
  // Nullable: el primer evento de un campo no tiene valor previo.
  previousValue Json?    @map("previous_value")
  newValue      Json     @map("new_value")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Company @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("compliance_events")
  @@schema("audit")
}
// D117 · El sello de un admin_monkey purgado: lo mínimo para que la auditoría siga diciendo quién fue (nunca el correo ni nada de acceso). Solo de añadir (trigger + REVOKE).
// `user_id` es el mismo uuid que tuvo en `users`; sin clave foránea porque esa fila ya no existe.
model AdminTombstone {
  userId   String   @id @map("user_id") @db.Uuid
  name     String?
  lastName String?  @map("last_name")
  role     UserRole
  purgedAt DateTime @default(now()) @map("purged_at")

  @@map("admin_tombstones")
  @@schema("audit")
}

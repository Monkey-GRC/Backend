enum Role {
  CLIENT_ADMIN
  USER
  VIEWER
  MONKEY_ADMIN
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  password   String
  name       String?
  last_name  String?
  username   String   @unique
  client_id  String?  @db.Uuid
  client     Client?  @relation(fields: [client_id], references: [id], onDelete: SetNull)
  role       Role     @default(USER)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String?
  updated_by String?

  refresh_token_hash       String?   @db.Text
  refresh_token_expires_at DateTime?

  created_templates Template[] @relation("mnk_user_created_templates")
  updated_templates Template[] @relation("mnk_user_updated_templates")

  created_reasons Reason[] @relation("mnk_user_created_reasons")
  updated_reasons Reason[] @relation("mnk_user_updated_reasons")

  created_risks Risk[] @relation("mnk_user_created_risks")
  updated_risks Risk[] @relation("mnk_user_updated_risks")

  @@map("mnk_users")
}

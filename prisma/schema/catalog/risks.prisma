enum FailureCategory {
  human_resource
  infrastructure
  @@schema("catalog")
}

model Risk {
  id                 String  @id @default(uuid()) @db.Uuid
  code               String  @unique
  name               String
  description        String  @db.Text
  trustCriterion     String  @map("trust_criterion")
  potentialImpact    Json    @map("potential_impact")
  likelihood         Int
  impact             Int
  inherentRiskValue  Int     @map("inherent_risk_value")
  inherentRiskLevel  String  @map("inherent_risk_level")
  isActive           Boolean @default(true) @map("is_active")

  riskCauses     RiskCause[]
  serviceRisks ServiceRisk[]
  residualRisks  ResidualRisk[]
  riskTreatments RiskTreatment[]
  mitigations    Mitigation[]

  @@map("risks")
  @@schema("catalog")
}

model Cause {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique
  name            String
  failureCategory FailureCategory @map("failure_category")
  description     String          @db.Text

  riskCauses     RiskCause[]
  causeControls  CauseControl[]
  mitigations Mitigation[]

  @@map("causes")
  @@schema("catalog")
}

model RiskCause {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  riskId  String @map("risk_id") @db.Uuid
  causeId String @map("cause_id") @db.Uuid

  risk  Risk  @relation(fields: [riskId], references: [id])
  cause Cause @relation(fields: [causeId], references: [id])

  @@unique([riskId, causeId])
  @@map("risk_causes")
  @@schema("catalog")
}

model CauseControl {
  id        String @id @default(uuid()) @db.Uuid
  causeId   String @map("cause_id") @db.Uuid
  controlId String @map("control_id") @db.Uuid

  cause   Cause   @relation(fields: [causeId], references: [id])
  control Control @relation(fields: [controlId], references: [id])

  @@unique([causeId, controlId])
  @@map("cause_controls")
  @@schema("catalog")
}
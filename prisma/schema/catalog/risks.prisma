// Las 6 categorías de la hoja Causas del Excel del comité (Categoria_Falla).
enum FailureCategory {
  human_resource        // Recurso Humano
  processes             // Procesos
  information_technology // Tecnología de Información
  infrastructure        // Infraestructura
  external              // Externos
  governance            // Gobierno

  @@map("failure_category")
  @@schema("catalog")
}

// Lista desplegable "Criterio" de la hoja Riesgos. NO es el de los TSC: incluye Cumplimiento,
// Continuidad, Fraude, Terceros, Reputación y Operación, que no son criterios de confianza.
enum RiskCriterion {
  confidentiality
  integrity
  availability
  privacy
  compliance
  security
  continuity
  third_parties
  fraud
  reputation
  operations

  @@map("risk_criterion")
  @@schema("catalog")
}

// Niveles de la matriz 5×5 (P×I): Bajo 1-4, Moderado 5-9, Alto 10-16, Crítico 17-25. Sirve al riesgo
// inherente (client_risks) y al residual (residual_risks).
enum RiskLevel {
  low
  moderate
  high
  critical

  @@map("risk_level")
  @@schema("catalog")
}

// Catálogo v2 (D129): reemplazan a failure_category.
enum CauseOrigin {
  internal
  external

  @@map("cause_origin")
  @@schema("catalog")
}

enum CauseType {
  human
  processes
  information
  measurement
  technology
  physical_infrastructure
  criminal_security
  third_parties
  legal_regulatory
  environmental
  organizational_governance
  internal_financial
  strategic
  external_technology
  climate
  biological
  political
  economic

  @@map("cause_type")
  @@schema("catalog")
}

model Risk {
  id                 String  @id @default(uuid()) @db.Uuid
  code               String  @unique
  name               String
  description        String  @db.Text
  trustCriterion     RiskCriterion @map("trust_criterion")
  potentialImpact    Json    @map("potential_impact")
  // El catálogo trae los 10 riesgos SIN probabilidad ni impacto (el Excel los deja vacíos): los
  // evalúa cada cliente sobre la matriz 5×5 en su copia (client_risks). Por eso son nullable.
  likelihood         Int?
  impact             Int?
  inherentRiskValue  Int?    @map("inherent_risk_value")
  inherentRiskLevel  RiskLevel? @map("inherent_risk_level")
  isActive           Boolean @default(true) @map("is_active")
  // De dónde viene la fila: el Excel del comité o Monkey Admin (contracts/modules/monkey-admin-catalog.md). El seed no toca las `monkey_admin`.
  origin      CatalogOrigin @default(committee)

  riskCauses  RiskCause[]
  clientRisks ClientRisk[] // copias que cada cliente particulariza (tenant.client_risks)

  @@map("risks")
  @@schema("catalog")
}

model Cause {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique
  // v2: nulos (la causa ya no trae nombre ni categoría de falla).
  name            String?
  failureCategory FailureCategory? @map("failure_category")
  // v2. Ojo: `origin` (abajo) ya es catalog_origin; el origen interno/externo de la causa va en `cause_origin`.
  causeOrigin     CauseOrigin?     @map("cause_origin")
  causeType       CauseType?       @map("cause_type")
  description     String          @db.Text
  // De dónde viene la fila: el Excel del comité o Monkey Admin (contracts/modules/monkey-admin-catalog.md). El seed no toca las `monkey_admin`.
  origin      CatalogOrigin @default(committee)
  // Dar de baja no borra: las copias de cada empresa y las evaluaciones apuntan al catálogo.
  isActive    Boolean @default(true) @map("is_active")

  riskCauses    RiskCause[]
  causeControls CauseControl[]
  clientCauses  ClientCause[] // copias que cada cliente particulariza (tenant.client_causes)

  @@map("causes")
  @@schema("catalog")
}

model RiskCause {
  id      String @id @default(uuid()) @db.Uuid
  // Nulo en la v2.
  code    String? @unique
  riskId  String @map("risk_id") @db.Uuid
  causeId String @map("cause_id") @db.Uuid

  risk  Risk  @relation(fields: [riskId], references: [id])
  cause Cause @relation(fields: [causeId], references: [id])

  @@unique([riskId, causeId])
  @@index([causeId])
  @@map("risk_causes")
  @@schema("catalog")
}

model CauseControl {
  id        String @id @default(uuid()) @db.Uuid
  causeId   String @map("cause_id") @db.Uuid
  controlId String @map("control_id") @db.Uuid

  cause   Cause   @relation(fields: [causeId], references: [id])
  control Control @relation(fields: [controlId], references: [id])

  @@unique([causeId, controlId])
  @@index([controlId])
  @@map("cause_controls")
  @@schema("catalog")
}
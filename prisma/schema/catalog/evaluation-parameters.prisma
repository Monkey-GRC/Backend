// RC-19 · MD-495 · Los parámetros del motor de evaluación (§9 «Los parámetros»): una fila por parámetro, un solo valor de Monkey para todos los clientes (D140).
// Contrato: contracts/catalogo-maestro.md «Parámetros de evaluación (RC-19)».

enum EvaluationParameterUnit {
  percent
  days
  hours
  months
  count
  boolean
  days_by_periodicity
  window_mode

  @@map("evaluation_parameter_unit")
  @@schema("catalog")
}

model EvaluationParameter {
  key          String                  @id
  code         String?
  unit         EvaluationParameterUnit
  value        Json
  defaultValue Json                    @map("default_value")
  sortOrder    Int                     @map("sort_order")
  updatedAt    DateTime?               @map("updated_at")
  updatedById  String?                 @map("updated_by") @db.Uuid

  updatedBy User? @relation("EvaluationParameterUpdatedBy", fields: [updatedById], references: [id])

  @@map("evaluation_parameters")
  @@schema("catalog")
}

// MD-508, D153 · El historial de cambios (valor anterior y nuevo) de cada parámetro: lo escribe el PATCH y lo leen las pasadas por empresa para avisar el cambio. Inmutable.
model EvaluationParameterChange {
  id            String   @id @default(uuid()) @db.Uuid
  parameterKey  String   @map("parameter_key")
  code          String?
  previousValue Json     @map("previous_value")
  newValue      Json     @map("new_value")
  changedAt     DateTime @default(now()) @map("changed_at")
  // Sin clave foránea (como `audit_logs.user_id`, D117): el historial no se reescribe aunque la cuenta se purgue.
  changedById   String?  @map("changed_by") @db.Uuid

  @@index([changedAt])
  @@map("evaluation_parameter_changes")
  @@schema("catalog")
}

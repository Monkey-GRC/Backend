enum Dimension {
  policy
  server
  database
  app
  cloud

  @@map("dimension")

  @@schema("catalog")
}

enum ControlDimensionType {
  manual
  automated
  hybrid
  technical_manual

  @@map("control_dimension_type")

  @@schema("catalog")
}

model Control {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // CAP-1, GOV-11
  // Uno de los 27 dominios del catálogo ("Gestión de Activos", "Monitoreo Continuo"…). Es del CONTROL,
  // no del requisito: en el Excel del comité cambia dentro de un mismo requisito (41 de 61). No se
  // deriva del prefijo del código (AST tiene dos dominios): se guarda el valor literal.
  domain      String
  name        String
  description String  @db.Text
  sourceRef   String? @map("source_ref")

  pointOfFocusControls PointOfFocusControl[]
  dimensions           ControlDimensionEntry[]
  measurements         ControlMeasurement[]
  controlPolicies      ControlPolicy[]
  controlTests         ControlTest[]
  testPlans            TestPlan[]
  causeControl         CauseControl[]
  clientControls        ClientControl[] // copias que cada cliente particulariza (tenant.client_controls)
  evidenceTemplates     ControlEvidenceTemplate[]

  @@map("controls")
  @@schema("catalog")
}

model PointOfFocusControl {
  id             String @id @default(uuid()) @db.Uuid
  pointOfFocusId String @map("point_of_focus_id") @db.Uuid
  controlId      String @map("control_id") @db.Uuid

  pointOfFocus PointOfFocus @relation(fields: [pointOfFocusId], references: [id])
  control      Control      @relation(fields: [controlId], references: [id])

  @@unique([pointOfFocusId, controlId])
  @@index([controlId])
  @@map("point_of_focus_controls")
  @@schema("catalog")
}

model ControlDimensionEntry {
  id                            String               @id @default(uuid()) @db.Uuid
  controlId                     String               @map("control_id") @db.Uuid
  dimension                     Dimension
  type                          ControlDimensionType
  requiresProbe                 Boolean              @default(false) @map("requires_probe")
  requiresAi                    Boolean              @default(false) @map("requires_ai")
  requiresComplianceConfirmation Boolean             @default(false) @map("requires_compliance_confirmation")
  reasonNotApplicable           String?              @map("reason_not_applicable") @db.Text

  control Control @relation(fields: [controlId], references: [id])

  @@unique([controlId, dimension])
  @@map("control_dimensions")
  @@schema("catalog")
}

model ControlMeasurement {
  id        String    @id @default(uuid()) @db.Uuid
  controlId String    @map("control_id") @db.Uuid
  dimension Dimension
  weight    Decimal   @default(1) @db.Decimal(5, 2)
  formula   String

  control Control @relation(fields: [controlId], references: [id])

  @@unique([controlId, dimension])
  @@map("control_measurements")
  @@schema("catalog")
}

// Plantilla de política del catálogo (D39): solo el nombre. La aprobación, la vigencia y la versión son
// estado del CLIENTE, no de una plantilla global, y viven en la evidencia que él entrega.
model Policy {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  controlPolicies ControlPolicy[]

  @@map("policies")
  @@schema("catalog")
}

model ControlPolicy {
  id        String @id @default(uuid()) @db.Uuid
  controlId String @map("control_id") @db.Uuid
  policyId  String @map("policy_id") @db.Uuid
  // El Excel lo distingue: "depende de la aprobación de la política" o además "y la aceptación del empleado".
  requiresEmployeeAcceptance Boolean @default(false) @map("requires_employee_acceptance")

  control Control @relation(fields: [controlId], references: [id])
  policy  Policy  @relation(fields: [policyId], references: [id])

  @@unique([controlId, policyId])
  @@index([policyId])
  @@map("control_policies")
  @@schema("catalog")
}

// Plantillas de evidencia (documentos que el comité vincula a cada control: 67 de 119 controles, 89
// vínculos, ~55 documentos distintos; uno sirve a varios controles). Al contratar un marco se clonan a
// tenant.evidence_requirements, por control del cliente (D36).
model EvidenceTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique // DOC-001…
  description String    @db.Text
  // El Excel no trae dimensión: son documentos, así que `policy` (documental).
  dimension   Dimension @default(policy)

  controls ControlEvidenceTemplate[]

  @@map("evidence_templates")
  @@schema("catalog")
}

model ControlEvidenceTemplate {
  id                 String @id @default(uuid()) @db.Uuid
  controlId          String @map("control_id") @db.Uuid
  evidenceTemplateId String @map("evidence_template_id") @db.Uuid
  sequence           Int // orden en que el comité lista los documentos del control

  control          Control          @relation(fields: [controlId], references: [id])
  evidenceTemplate EvidenceTemplate @relation(fields: [evidenceTemplateId], references: [id])

  @@unique([controlId, evidenceTemplateId])
  @@unique([controlId, sequence])
  @@index([evidenceTemplateId])
  @@map("control_evidence_templates")
  @@schema("catalog")
}

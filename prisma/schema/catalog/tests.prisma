enum TestPlanOrigin {
  predefined
  custom

  @@map("test_plan_origin")
  @@schema("catalog")
}

enum TestType {
  documentary
  population
  operational
  technical

  @@map("test_type")
  @@schema("catalog")
}

enum TestPrimarySource {
  document
  manual
  probe
  cloud_engine
  probe_and_cloud_engine
  integration

  @@map("test_primary_source")
  @@schema("catalog")
}

enum TestLevel {
  design
  implementation
  effectiveness
  implementation_and_effectiveness

  @@map("test_level")
  @@schema("catalog")
}

enum TestAutomation {
  manual
  semi_automated
  automated

  @@map("test_automation")
  @@schema("catalog")
}

// Qué hace el check en su prueba (D129): solo `direct` decide.
enum CheckRole {
  direct
  complementary
  dependency

  @@map("check_role")
  @@schema("catalog")
}

enum CheckOrigin {
  cis_native
  monkey_policy
  auditor_criterion
  // Check de un motor de configuración de nube (D56); su mapeo propio se guarda con procedencia, no se presenta como del comité.
  engine_native

  @@map("check_origin")
  @@schema("catalog")
}

// Confianza del mapeo check ↔ requisito. Valores tomados de monkey-cis-sync: confirmed, high, medium y low (queda para revisión).
enum MappingConfidence {
  confirmed
  high
  medium
  low

  @@map("mapping_confidence")
  @@schema("catalog")
}

// Quién afirma un mapeo (D56). Un mapeo del motor o propuesto por Monkey nunca se presenta como si lo hubiera validado el comité.
enum MappingProvenance {
  engine_native
  monkey_proposed
  committee_ratified

  @@map("mapping_provenance")
  @@schema("catalog")
}

model TestPlan {
  id            String         @id @default(uuid()) @db.Uuid
  controlId     String         @map("control_id") @db.Uuid
  description   String         @db.Text
  steps         Json
  population    String
  samplingRule  String         @map("sampling_rule")
  origin        TestPlanOrigin

  control Control @relation(fields: [controlId], references: [id])

  @@index([controlId])
  @@map("test_plans")
  @@schema("catalog")
}

// ⚠️ Texto interno. Las pruebas del comité nombran al proveedor del motor de monitoreo en 15 de sus 23
// columnas (tool, automated_coverage, limitations, prerequisites, step_by_step…) e incluso en 4 nombres:
// ninguno de estos textos sale tal cual a la UI, a un reporte ni a un texto generado por IA.
model Test {
  id                             String    @id @default(uuid()) @db.Uuid
  code                           String    @unique
  dimension                      Dimension
  name                          String?
  // El nombre neutro que ve el cliente (D70): lo escribe Monkey. `name` es del comité y puede nombrar al proveedor del motor, así que nunca sale de la API.
  displayName                    String?   @map("display_name")
  // El mismo nombre neutro en inglés. Nullable: solo las pruebas que ya lo tienen traducido; sin él, se muestra `display_name` (MD-211).
  displayNameEn                  String?   @map("display_name_en")
  // La descripción corta que ve el cliente (D82): el objetivo del comité, o una reescritura cuando el objetivo nombra al proveedor del motor. Nullable: se carga como dato.
  displayDescription             String?   @map("display_description") @db.Text
  objective                      String    @db.Text
  // Texto libre a propósito: en la hoja Pruebas del comité mezcla "Manual", "Mixta", "Técnica" y
  // descripciones largas ("Prueba de diseño y efectividad operativa (control automatizado…)").
  // v2: documentary|population|operational|technical.
  type                          TestType?
  tool                          String?
  population                    String?
  period                        String?
  // TEXTO, no enteros: en la hoja Pruebas son frases ("Por determinar con base en el inventario de
  // proveedores", "N<5 → 100%; si no, 10% de la población (mín. 5, máx. 25)"). D8: el muestreo se guarda
  // como dato ahora y el cálculo de la muestra concreta se construye después.
  populationSize                String?            @map("population_size") @db.Text
  suggestedSampleSize           String?            @map("suggested_sample_size") @db.Text
  selectionMethod               String?            @map("selection_method")
  evidenceToRequest             String?            @map("evidence_to_request") @db.Text
  prerequisites                 String?            @db.Text
  // v2: texto. En la v1 era una lista JSON; la migración la convierte a texto.
  stepByStep                    String?            @map("step_by_step") @db.Text
  attributesToValidate          Json?              @map("attributes_to_validate")
  complianceCriterion           String?            @map("compliance_criterion") @db.Text
  // "EXCEPCIONES / DESVIACIONES": qué se considera excepción. Es distinta de exceptions_handling
  // ("TRATAMIENTO DE EXCEPCIONES"): la hoja trae las dos y el schema solo guardaba una.
  exceptions                    String?            @db.Text
  exceptionsHandling            String?            @map("exceptions_handling") @db.Text
  evidenceToRetain              String?            @map("evidence_to_retain") @db.Text
  automatedCoverage             String?            @map("automated_coverage") @db.Text
  complementaryManualValidation String?            @map("complementary_manual_validation") @db.Text
  limitations                   String?            @db.Text
  // Catálogo v2 (VF18, hoja TEST). `control_id` es nulo en las T-DOC (su control es el de sus documentos).
  controlId                     String?            @map("control_id") @db.Uuid
  primarySource                 TestPrimarySource? @map("primary_source")
  standardProcedureId           String?            @map("standard_procedure_id") @db.Uuid
  whyItMatters                  String?            @map("why_it_matters") @db.Text
  correctIf                     String?            @map("correct_if") @db.Text
  exceptionIf                   String?            @map("exception_if") @db.Text
  observationIf                 String?            @map("observation_if") @db.Text
  level                         TestLevel?
  frequencySample               String?            @map("frequency_sample") @db.Text
  integrationCategoryId         String?            @map("integration_category_id") @db.Uuid
  automation                    TestAutomation?
  displayNameReviewed           Boolean            @default(false) @map("display_name_reviewed")
  // De dónde viene la fila: el Excel del comité o Monkey Admin (contracts/modules/monkey-admin-catalog.md). El seed no toca las `monkey_admin`.
  origin      CatalogOrigin @default(committee)
  // Dar de baja no borra: las copias de cada empresa y las evaluaciones apuntan al catálogo.
  isActive    Boolean @default(true) @map("is_active")

  control             Control?                 @relation("TestControl", fields: [controlId], references: [id], onDelete: Restrict)
  standardProcedure   StandardProcedure?       @relation(fields: [standardProcedureId], references: [id], onDelete: Restrict)
  integrationCategory IntegrationCategory?     @relation(fields: [integrationCategoryId], references: [id], onDelete: Restrict)
  requirementTests    ControlRequirementTest[]
  document            Document?

  controlTests ControlTest[]
  testChecks   TestCheck[]
  exclusions Exclusion[]
  evaluations Evaluation[]
  manualTestResults ManualTestResult[]
  clientControlTests ClientControlTest[]
  remediationPlans RemediationPlan[]
  // D88: los documentos que sirven a esta prueba (plantillas del catálogo y evidencias de cada control del cliente).
  controlEvidenceTemplates ControlEvidenceTemplate[]
  evidenceRequirements     EvidenceRequirement[]

  @@index([controlId])
  @@index([standardProcedureId])
  @@index([integrationCategoryId])
  @@map("tests")
  @@schema("catalog")
}

model ControlTest {
  id        String @id @default(uuid()) @db.Uuid
  controlId String @map("control_id") @db.Uuid
  testId    String @map("test_id") @db.Uuid

  control Control @relation(fields: [controlId], references: [id])
  test    Test    @relation(fields: [testId], references: [id])

  @@unique([controlId, testId])
  @@index([testId])
  @@map("control_tests")
  @@schema("catalog")
}

enum CheckTranslationOrigin {
  machine
  reviewed

  @@map("check_translation_origin")
  @@schema("catalog")
}

model Check {
  id                 String      @id @default(uuid()) @db.Uuid
  platform           String
  policyId           String      @map("policy_id")
  checkId            String      @map("check_id")
  // Nullable: los checks del motor de nube solo traen título en inglés; la traducción es posterior (DT-21).
  titleEs            String?     @map("title_es")
  titleEn            String      @map("title_en")
  condition          String      @db.Text
  remediation        String      @db.Text
  // D90 · La guía de corrección en español. El original (`remediation`) es interno y está en inglés; esta es la traducción de Monkey. `translation_origin` dice quién la
  // escribió: `machine` es una traducción automática sin revisar (y se etiqueta así al cliente); `reviewed`, una persona la revisó. Nula = aún sin traducir.
  remediationEs      String?     @map("remediation_es") @db.Text
  translationOrigin  CheckTranslationOrigin? @map("translation_origin")
  // Nullable: el motor de nube no expone una regla de verificación propia, y no se inventa una.
  verificationRule   String?     @map("verification_rule") @db.Text
  origin             CheckOrigin
  mappingProvenance  String      @map("mapping_provenance")
  mappingConfidence  MappingConfidence @map("mapping_confidence")
  // La política SCA que contiene el check (sca_policies ||--o{ checks). Nullable: el check
  // se carga primero y se enlaza a su política al importar el catálogo.
  scaPolicyId        String?     @map("sca_policy_id") @db.Uuid
  // Solo checks de un motor de nube (D56). Interno: nunca sale al cliente (el texto nombra al proveedor en algunos casos).
  serviceName        String?     @map("service_name")
  resourceType       String?     @map("resource_type")
  engineSeverity     String?     @map("engine_severity")
  categories         Json?

  scaPolicy ScaPolicy? @relation(fields: [scaPolicyId], references: [id])

  testChecks     TestCheck[]
  checkMappings  CheckMapping[]
  checkResults CheckResult[]
  evaluations  Evaluation[]

  @@unique([platform, policyId, checkId])
  @@index([scaPolicyId])
  @@map("checks")
  @@schema("catalog")
}

model TestCheck {
  id      String @id @default(uuid()) @db.Uuid
  testId  String @map("test_id") @db.Uuid
  // Nulo solo en los vínculos «N/A» de la v2 (módulo o puntaje global): guardan `module_ref` y el motor los ignora (CHECK en la migración).
  checkId         String?            @map("check_id") @db.Uuid
  role            CheckRole          @default(direct)
  commonObjective String?            @map("common_objective") @db.Text
  ownerControlId  String?            @map("owner_control_id") @db.Uuid
  appliesWhen     String?            @map("applies_when") @db.Text
  moduleRef       String?            @map("module_ref")
  // Quién asignó el check a la prueba y con qué confianza (D56). La asignación es del comité; hasta que la ratifique, es propuesta.
  provenance MappingProvenance @default(monkey_proposed)
  confidence MappingConfidence?
  rationale  String?           @db.Text

  test  Test  @relation(fields: [testId], references: [id])
  check        Check?   @relation(fields: [checkId], references: [id], onDelete: Restrict)
  ownerControl Control? @relation("TestCheckOwner", fields: [ownerControlId], references: [id], onDelete: Restrict)

  @@unique([testId, checkId])
  @@index([checkId])
  @@index([ownerControlId])
  @@map("test_checks")
  @@schema("catalog")
}

model CheckMapping {
  id               String @id @default(uuid()) @db.Uuid
  checkId          String @map("check_id") @db.Uuid
  frameworkCode    String @map("framework_code")
  frameworkVersion String @map("framework_version")
  requirementCode  String @map("requirement_code")
  provenance       MappingProvenance @default(engine_native)

  check Check @relation(fields: [checkId], references: [id])

  @@unique([checkId, frameworkCode, frameworkVersion, requirementCode])
  @@index([checkId])
  @@index([frameworkCode, requirementCode])
  @@map("check_mappings")
  @@schema("catalog")
}

// Una política de configuración de la sonda (D113). Es la fuente única de TRES cosas: la traducción nombre ↔ id (el comité nombra la política por su
// nombre y la sonda por su id), qué versiones de qué sistema se ofrecen al cliente, y cuántos checks tiene cada una.
model ScaPolicy {
  id         String @id @default(uuid()) @db.Uuid
  // La columna «Plataforma» del catálogo del comité tal cual («Ubuntu», «Windows», «Aplicaciones»…).
  platform   String
  // El NOMBRE de la política en el catálogo del comité y en la sonda («CIS Ubuntu Linux 22.04 LTS Benchmark v2.0.0.»).
  benchmark  String
  // El id oficial de la política en la sonda (`cis_ubuntu22-04`).
  scaId      String @unique @map("sca_id")
  yamlFile   String @map("yaml_file")
  checkCount Int    @map("check_count")
  // Sistema operativo (`linux`, `windows`, `macos`, `solaris`, `hp_ux`), igual que el código de la plataforma del catálogo de conexiones. Nulo: no es un
  // sistema (es un motor de base de datos o un servidor de aplicaciones) y no se ofrece como versión de un servidor.
  osCode           String? @map("os_code")
  // Código estable de la distribución (`ubuntu`, `windows_server`…) y su marca. Agrupan las versiones en la pantalla.
  distribution     String?
  distributionName String? @map("distribution_name")
  // La versión como la lee el cliente: «22.04 LTS», «2022», «13 Ventura».
  versionLabel     String? @map("version_label")
  // El código de ESTA versión en la API (`ubuntu_22_04_lts`, `windows_server_2022`): lo define Monkey, no la sonda. Así, si la sonda cambia el id de una
  // política, ni la API ni la pantalla se enteran. Nulo: no es un sistema operativo.
  versionCode      String? @unique @map("version_code")
  sortOrder        Int     @default(0) @map("sort_order")
  // Solo se OFRECE al cliente lo que la sonda realmente trae. Una política del catálogo que la sonda no entrega queda cargada pero no ofrecida: no se
  // promete una evaluación que no existe.
  isOfferable      Boolean @default(false) @map("is_offerable")

  checks      Check[]
  assetAgents AssetAgent[]

  @@index([osCode, isOfferable])
  @@map("sca_policies")
  @@schema("catalog")
}
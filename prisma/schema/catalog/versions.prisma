// Quién escribió una fila del catálogo maestro. `committee`: viene del Excel del comité (seed). `monkey_admin`: la agregó alguien de Monkey desde Monkey Admin.
enum CatalogOrigin {
  committee
  monkey_admin

  @@map("catalog_origin")
  @@schema("catalog")
}

model CatalogVersion {
  id                      String   @id @default(uuid()) @db.Uuid
  number                  Int
  publishedAt             DateTime @map("published_at") @db.Date
  changeSummary           String   @map("change_summary") @db.Text
  // Opcional: la carga inicial del catálogo la hace un script, sin publicador humano (D35). Sin clave foránea (D117): puede ser un admin_monkey que ya se purgó; el nombre sale del sello (audit.admin_tombstones).
  publishedBy             String?  @map("published_by") @db.Uuid
  propagatedAutomatically Boolean  @map("propagated_automatically")
  requiresAcceptance      Boolean  @map("requires_acceptance")

  serviceFrameworks ServiceFramework[]
  evaluations Evaluation[]

  @@map("catalog_versions")
  @@schema("catalog")
}
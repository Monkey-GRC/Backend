// D102 · `responsable` es el dueño de controles y lidera un equipo; `delegado` es el ejecutor que el responsable elige entre los de su equipo. Reemplazan a `funcional`.
enum UserRole {
  admin_monkey
  admin_empresa
  responsable
  delegado
  auditor

  @@map("user_role")

  @@schema("platform")
}

// pending (D95): la cuenta existe desde el alta pero la persona aún no activó su código; no puede iniciar sesión.
// D111 · El idioma en el que la persona usa Monkey (es · en).
enum Language {
  es
  en

  @@map("language")

  @@schema("platform")
}

enum UserStatus {
  active
  inactive
  suspended
  pending

  @@map("user_status")

  @@schema("platform")
}

enum GroupKind {
  responsables
  team

  @@map("group_kind")
  @@schema("platform")
}

enum ApiKeyStatus {
  active
  revoked

  @@map("api_key_status")

  @@schema("platform")
}

// D94 · Para qué se abrió un desafío del segundo factor: verificar el código (ya tiene el segundo factor) o configurarlo (primer ingreso).
enum MfaChallengePurpose {
  verify
  setup

  @@map("mfa_challenge_purpose")
  @@schema("platform")
}

model User {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  // Único global (no por empresa): el login recibe solo el email y un auditor es un solo
  // usuario que audita varias empresas. Siempre en minúsculas (CHECK en la migración).
  email          String      @unique
  // Opcionales: la cuenta se identifica por el correo (D51); el nombre se podrá completar en el perfil.
  name           String?
  lastName       String?     @map("last_name")
  passwordHash   String      @map("password_hash")
  role           UserRole
  status         UserStatus  @default(active)
  isMfaEnabled   Boolean     @default(false) @map("is_mfa_enabled")
  lastLoginAt    DateTime?   @map("last_login_at")
  // Políticas de §5.3: bloqueo tras 5 intentos por 15 min, contraseña vence a los 90 días,
  // secreto TOTP cifrado en reposo (el segundo factor entra con MD-94).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at")
  mfaSecretEncrypted  String?   @map("mfa_secret_encrypted") @db.Text
  // D94 · El último paso de 30 s aceptado: un código ya usado no se acepta dos veces.
  mfaLastUsedStep     Int?      @map("mfa_last_used_step")
  // D102 · Un solo grupo por persona (responsable y delegado); nulo para admin_empresa, auditor y admin_monkey.
  groupId             String?   @map("group_id") @db.Uuid
  // D102 · Solo `delegado`: true si es de la empresa, false si es externo. Nulo en los demás roles (lo impone un CHECK en la migración).
  isInternal          Boolean?  @map("is_internal")
  // D111 · Con él salen sus correos; lo fija el frontend (`PATCH /v1/auth/me/language`) y la cuenta invitada nace con el de quien la invita.
  preferredLanguage   Language  @default(es) @map("preferred_language")
  // D117 · Solo admin_monkey `inactive`: cuándo se borra la cuenta (desactivación + 7 días). Nulo en toda cuenta que no está en gracia.
  purgeAt        DateTime?   @map("purge_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  company    Company     @relation(fields: [companyId], references: [id])
  group      UserGroup?  @relation("GroupMembers", fields: [groupId], references: [id])

  groupsLed                 UserGroup[]                @relation("GroupLeader")
  controlsOwned             ClientControlAssignment[]  @relation("ControlOwner")
  controlsExecuted          ClientControlAssignment[]  @relation("ControlExecutor")
  controlAssignmentsGranted ClientControlAssignment[]  @relation("ControlAssignedBy")
  sessions                  Session[]
  trustedDevices            TrustedDevice[]
  activationCodes           UserActivationCode[]    @relation("ActivationCodeUser")
  mfaChallenges             MfaChallenge[]
  passwordHistory           PasswordHistory[]
  passwordResetTokens       PasswordResetToken[]
  recoveryCodes             UserRecoveryCode[]
  apiKeysCreated            ApiKey[]
  actionPlansResponsible    ActionPlan[]
  residualRisksAccepted     ResidualRisk[]
  riskTreatmentsCreated     RiskTreatment[] @relation("RiskTreatmentCreatedBy")
  evidenceSubmitted         EvidenceSubmission[] @relation("EvidenceSubmittedBy")
  evidenceReviewed          EvidenceReview[]     @relation("EvidenceReviewedBy")
  verdictsRegistered        TestVerdict[]        @relation("VerdictRegisteredBy")
  verdictsReviewed          TestVerdictReview[]  @relation("VerdictReviewedBy")
  assessmentsIssued         FrameworkAssessment[] @relation("AssessmentIssuedBy")
  exclusionsProposed        Exclusion[]          @relation("ExclusionProposedBy")
  exclusionsDecided         Exclusion[]          @relation("ExclusionDecidedBy")
  observationsWritten       AuditObservation[]   @relation("ObservationCreatedBy")
  observationsAnswered      AuditObservation[]   @relation("ObservationAnsweredBy")
  observationsClosed        AuditObservation[]   @relation("ObservationClosedBy")
  controlChangesRequested   ClientControlChange[] @relation("ControlChangeRequestedBy")
  controlChangesDecided     ClientControlChange[] @relation("ControlChangeDecidedBy")
  evaluationsConfirmed      Evaluation[]
  findingsReported          Finding[]

  @@index([companyId])
  @@index([groupId])
  @@map("users")
  @@schema("platform")
}

// D102 · Un grupo es un equipo: su líder (admin_empresa o responsable) y las personas que agrupa. company_id lo pide el RLS.
model UserGroup {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  leaderId  String   @map("leader_id") @db.Uuid
  // D104 · `responsables` lo lidera el admin_empresa; `team` es el equipo de delegados de un responsable (a lo sumo uno por líder: índice único parcial en la migración).
  kind      GroupKind
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  leader  User    @relation("GroupLeader", fields: [leaderId], references: [id])
  members User[]  @relation("GroupMembers")

  // D104 · Un nombre por empresa: «Responsables» es un solo grupo aunque dos altas lleguen a la vez.
  @@unique([companyId, name])
  @@index([companyId])
  @@index([leaderId])
  @@map("user_groups")
  @@schema("platform")
}

// D102 · Una fila por control del cliente: quién es su dueño (responsable o admin_empresa) y, si lo hay, su ejecutor (un delegado del equipo del dueño).
// Sin fila el control está «Sin asignar»; sin ejecutor lo ejecuta el dueño. No guarda dimensión (se eliminaron `user_dimensions` y `service_dimension_owners`).
model ClientControlAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  clientControlId String    @unique @map("client_control_id") @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  executorId      String?   @map("executor_id") @db.Uuid
  assignedBy      String    @map("assigned_by") @db.Uuid
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id])
  clientControl ClientControl @relation(fields: [clientControlId], references: [id])
  owner         User          @relation("ControlOwner", fields: [ownerId], references: [id])
  executor      User?         @relation("ControlExecutor", fields: [executorId], references: [id])
  assignedByUser User         @relation("ControlAssignedBy", fields: [assignedBy], references: [id])

  @@index([companyId])
  @@index([ownerId])
  @@index([executorId])
  @@map("client_control_assignments")
  @@schema("platform")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  ipAddress         String    @map("ip_address")
  userAgent         String    @map("user_agent")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  // Política de §5.3: la sesión muere a los 30 min sin actividad (last_activity_at) y a las
  // 8 h de creada (created_at), aunque siga activa.
  createdAt         DateTime  @default(now()) @map("created_at")
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at")

  user User @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("sessions")
  @@schema("platform")
}

// D123 · «Recordar este dispositivo por 30 días»: solo salta el código del segundo factor. La cookie `mnk_device` lleva un token opaco y aquí queda su HMAC (SEG-17, SEG-84).
// Vence a los 30 días de creado (el uso no lo renueva). `city` guarda los nombres por idioma ({ es, en }) de la base GeoIP local.
model TrustedDevice {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  browser    String?
  os         String?
  deviceType String?   @map("device_type")
  ipAddress  String    @map("ip_address")
  country    String?   @db.Char(2)
  city       Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("trusted_devices")
  @@schema("platform")
}

model ApiKey {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  createdBy     String       @map("created_by") @db.Uuid
  name          String
  keyHash       String       @unique @map("key_hash")
  status        ApiKeyStatus @default(active)
  lastRotatedAt DateTime     @map("last_rotated_at") // rotación máx. 90 días

  company     Company @relation(fields: [companyId], references: [id])
  createdByUser User  @relation(fields: [createdBy], references: [id])

  @@index([companyId])
  @@map("api_keys")
  @@schema("platform")
}

// D94 · Entre la contraseña correcta y la sesión hay un desafío: dura 5 minutos, se usa una vez y se rinde a los 5 intentos. El token solo viaja en
// una cookie httpOnly y aquí queda su huella. En un desafío de configuración, el secreto nuevo espera cifrado hasta que la persona lo confirma con un código.
model MfaChallenge {
  id                     String              @id @default(uuid()) @db.Uuid
  companyId              String              @map("company_id") @db.Uuid
  userId                 String              @map("user_id") @db.Uuid
  tokenHash              String              @unique @map("token_hash")
  purpose                MfaChallengePurpose
  pendingSecretEncrypted String?             @map("pending_secret_encrypted") @db.Text
  failedAttempts         Int                 @default(0) @map("failed_attempts")
  ipAddress              String              @map("ip_address")
  expiresAt              DateTime            @map("expires_at")
  consumedAt             DateTime?           @map("consumed_at")
  createdAt              DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("mfa_challenges")
  @@schema("platform")
}

// D95 · Código de activación de un solo uso: lo emite quien crea la cuenta (el admin_empresa o el responsable, según el rol; D96, D102) y la persona lo canjea para poner su
// contraseña y pasar de `pending` a `active`. Como la clave de acceso de una empresa: solo queda su huella (HMAC), vence y no se reutiliza.
// company_id es el de la cuenta a activar (el de su RLS), no el de quien la crea.
model UserActivationCode {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @map("company_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  // Sin clave foránea (D117): quien emitió el código puede ser un admin_monkey que ya se purgó; el nombre sale del sello.
  createdBy String          @map("created_by") @db.Uuid
  codeHash  String          @unique @map("code_hash")
  status    AccessKeyStatus @default(pending)
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")
  createdAt DateTime        @default(now()) @map("created_at")

  company        Company @relation(fields: [companyId], references: [id])
  user           User    @relation("ActivationCodeUser", fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("user_activation_codes")
  @@schema("platform")
}

// D94 · Códigos de recuperación: 10 por persona, de un solo uso, guardados solo como huella.
model UserRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_recovery_codes")
  @@schema("platform")
}

// D101 · Las contraseñas anteriores de una persona, solo como hash bcrypt: sirven para no volver a una reciente y para contar los cambios de las últimas 24 h. Cada
// cambio guarda aquí la contraseña que se deja; la vigente sigue en `users.password_hash`.
model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([companyId])
  @@map("password_history")
  @@schema("platform")
}

// D101 · Enlace de «olvidé mi contraseña»: de un solo uso, dura 30 min y solo queda su huella (HMAC con TOKEN_HASH_PEPPER). Uno nuevo invalida los anteriores.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([companyId])
  @@map("password_reset_tokens")
  @@schema("platform")
}

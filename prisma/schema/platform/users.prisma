enum UserRole {
  admin_monkey
  admin_empresa
  funcional
  auditor

  @@map("user_role")

  @@schema("platform")
}

// pending (D95): la cuenta existe desde el alta pero la persona aún no activó su código; no puede iniciar sesión.
enum UserStatus {
  active
  inactive
  suspended
  pending

  @@map("user_status")

  @@schema("platform")
}

enum ApiKeyStatus {
  active
  revoked

  @@map("api_key_status")

  @@schema("platform")
}

// D94 · Para qué se abrió un desafío del segundo factor: verificar el código (ya tiene el segundo factor) o configurarlo (primer ingreso).
enum MfaChallengePurpose {
  verify
  setup

  @@map("mfa_challenge_purpose")
  @@schema("platform")
}

model User {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  // Único global (no por empresa): el login recibe solo el email y un auditor es un solo
  // usuario que audita varias empresas. Siempre en minúsculas (CHECK en la migración).
  email          String      @unique
  // Opcionales: la cuenta se identifica por el correo (D51); el nombre se podrá completar en el perfil.
  name           String?
  lastName       String?     @map("last_name")
  passwordHash   String      @map("password_hash")
  role           UserRole
  status         UserStatus  @default(active)
  isMfaEnabled   Boolean     @default(false) @map("is_mfa_enabled")
  lastLoginAt    DateTime?   @map("last_login_at")
  // Políticas de §5.3: bloqueo tras 5 intentos por 15 min, contraseña vence a los 90 días,
  // secreto TOTP cifrado en reposo (el segundo factor entra con MD-94).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at")
  mfaSecretEncrypted  String?   @map("mfa_secret_encrypted") @db.Text
  // D94 · El último paso de 30 s aceptado: un código ya usado no se acepta dos veces.
  mfaLastUsedStep     Int?      @map("mfa_last_used_step")
  createdAt      DateTime    @default(now()) @map("created_at")

  company    Company     @relation(fields: [companyId], references: [id])

  dimensions                UserDimension[]
  dimensionOwnerships       ServiceDimensionOwner[] @relation("DimensionOwner")
  dimensionOwnershipsGranted ServiceDimensionOwner[] @relation("DimensionOwnerAssignedBy")
  controlAssignments        UserControlAssignment[] @relation("AssignedUser")
  controlAssignmentsGranted UserControlAssignment[] @relation("AssignedByUser")
  sessions                  Session[]
  activationCodes           UserActivationCode[]    @relation("ActivationCodeUser")
  activationCodesCreated    UserActivationCode[]    @relation("ActivationCodeCreatedBy")
  mfaChallenges             MfaChallenge[]
  passwordHistory           PasswordHistory[]
  passwordResetTokens       PasswordResetToken[]
  recoveryCodes             UserRecoveryCode[]
  apiKeysCreated            ApiKey[]
  accessKeysCreated         AccessKey[]
  frameworksContracted      CompanyFramework[]
  catalogVersionsPublished  CatalogVersion[]
  actionPlansResponsible    ActionPlan[]
  residualRisksAccepted     ResidualRisk[]
  riskTreatmentsCreated     RiskTreatment[] @relation("RiskTreatmentCreatedBy")
  evidenceSubmitted         EvidenceSubmission[] @relation("EvidenceSubmittedBy")
  evidenceReviewed          EvidenceReview[]     @relation("EvidenceReviewedBy")
  assessmentsIssued         FrameworkAssessment[] @relation("AssessmentIssuedBy")
  exclusionsProposed        Exclusion[]          @relation("ExclusionProposedBy")
  exclusionsDecided         Exclusion[]          @relation("ExclusionDecidedBy")
  observationsWritten       AuditObservation[]   @relation("ObservationCreatedBy")
  observationsAnswered      AuditObservation[]   @relation("ObservationAnsweredBy")
  observationsClosed        AuditObservation[]   @relation("ObservationClosedBy")
  controlChangesRequested   ClientControlChange[] @relation("ControlChangeRequestedBy")
  controlChangesDecided     ClientControlChange[] @relation("ControlChangeDecidedBy")
  evaluationsConfirmed      Evaluation[]
  findingsReported          Finding[]
  auditLogs        AuditLog[]
  complianceEvents ComplianceEvent[]

  @@index([companyId])
  @@map("users")
  @@schema("platform")
}

model UserControlAssignment {
  id       String   @id @default(uuid()) @db.Uuid
  companyId       String @map("company_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  clientControlId String @map("client_control_id") @db.Uuid
  // D96 · La excepción es por control Y dimensión: una fila por par, que manda sobre el responsable del servicio en esa dimensión.
  dimension Dimension
  assignedBy String   @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user          User @relation("AssignedUser", fields: [userId], references: [id])
  assignedByUser User @relation("AssignedByUser", fields: [assignedBy], references: [id])
  clientControl ClientControl @relation(fields: [clientControlId], references: [id])
  company        Company       @relation(fields: [companyId], references: [id])

  @@unique([clientControlId, dimension])
  @@index([companyId])
  @@index([userId])
  @@index([clientControlId])
  @@map("user_control_assignments")
  @@schema("platform")
}

// D96 · La especialidad de un funcional: una o más de las cinco dimensiones. Es un atributo de la persona, no un rol. Que el usuario sea `funcional` lo impone la aplicación.
model UserDimension {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  dimension Dimension
  createdAt DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, dimension])
  @@index([companyId])
  @@map("user_dimensions")
  @@schema("platform")
}

// D96 · El responsable principal de un servicio en una dimensión: un funcional con esa especialidad. Una fila por servicio y dimensión. El responsable efectivo de un
// control en una dimensión es su excepción (`user_control_assignments`) o, si no hay, esta fila; no se guarda una fila por control.
model ServiceDimensionOwner {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  serviceId  String    @map("service_id") @db.Uuid
  dimension  Dimension
  userId     String    @map("user_id") @db.Uuid
  assignedBy String    @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")

  user           User    @relation("DimensionOwner", fields: [userId], references: [id])
  assignedByUser User    @relation("DimensionOwnerAssignedBy", fields: [assignedBy], references: [id])
  service        Service @relation(fields: [serviceId], references: [id])
  company        Company @relation(fields: [companyId], references: [id])

  @@unique([serviceId, dimension])
  @@index([companyId])
  @@index([userId])
  @@map("service_dimension_owners")
  @@schema("platform")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  ipAddress         String    @map("ip_address")
  userAgent         String    @map("user_agent")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  // Política de §5.3: la sesión muere a los 30 min sin actividad (last_activity_at) y a las
  // 8 h de creada (created_at), aunque siga activa.
  createdAt         DateTime  @default(now()) @map("created_at")
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at")

  user User @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("sessions")
  @@schema("platform")
}

model ApiKey {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  createdBy     String       @map("created_by") @db.Uuid
  name          String
  keyHash       String       @unique @map("key_hash")
  status        ApiKeyStatus @default(active)
  lastRotatedAt DateTime     @map("last_rotated_at") // rotación máx. 90 días

  company     Company @relation(fields: [companyId], references: [id])
  createdByUser User  @relation(fields: [createdBy], references: [id])

  @@index([companyId])
  @@map("api_keys")
  @@schema("platform")
}

// D94 · Entre la contraseña correcta y la sesión hay un desafío: dura 5 minutos, se usa una vez y se rinde a los 5 intentos. El token solo viaja en
// una cookie httpOnly y aquí queda su huella. En un desafío de configuración, el secreto nuevo espera cifrado hasta que la persona lo confirma con un código.
model MfaChallenge {
  id                     String              @id @default(uuid()) @db.Uuid
  companyId              String              @map("company_id") @db.Uuid
  userId                 String              @map("user_id") @db.Uuid
  tokenHash              String              @unique @map("token_hash")
  purpose                MfaChallengePurpose
  pendingSecretEncrypted String?             @map("pending_secret_encrypted") @db.Text
  failedAttempts         Int                 @default(0) @map("failed_attempts")
  ipAddress              String              @map("ip_address")
  expiresAt              DateTime            @map("expires_at")
  consumedAt             DateTime?           @map("consumed_at")
  createdAt              DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("mfa_challenges")
  @@schema("platform")
}

// D95 · Código de activación de un solo uso: lo emite quien crea la cuenta (el admin_empresa, para funcional y auditor; D96) y la persona lo canjea para poner su
// contraseña y pasar de `pending` a `active`. Como la clave de acceso de una empresa: solo queda su huella (HMAC), vence y no se reutiliza.
// company_id es el de la cuenta a activar (el de su RLS), no el de quien la crea.
model UserActivationCode {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @map("company_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  createdBy String          @map("created_by") @db.Uuid
  codeHash  String          @unique @map("code_hash")
  status    AccessKeyStatus @default(pending)
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")
  createdAt DateTime        @default(now()) @map("created_at")

  company        Company @relation(fields: [companyId], references: [id])
  user           User    @relation("ActivationCodeUser", fields: [userId], references: [id])
  createdByUser  User    @relation("ActivationCodeCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("user_activation_codes")
  @@schema("platform")
}

// D94 · Códigos de recuperación: 10 por persona, de un solo uso, guardados solo como huella.
model UserRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_recovery_codes")
  @@schema("platform")
}

// D101 · Las contraseñas anteriores de una persona, solo como hash bcrypt: sirven para no volver a una reciente y para contar los cambios de las últimas 24 h. Cada
// cambio guarda aquí la contraseña que se deja; la vigente sigue en `users.password_hash`.
model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([companyId])
  @@map("password_history")
  @@schema("platform")
}

// D101 · Enlace de «olvidé mi contraseña»: de un solo uso, dura 30 min y solo queda su huella (HMAC con TOKEN_HASH_PEPPER). Uno nuevo invalida los anteriores.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([companyId])
  @@map("password_reset_tokens")
  @@schema("platform")
}

enum IsolationStrategy {
  dedicated
  shared

  @@map("isolation_strategy")

  @@schema("platform")
}

enum CompanyStatus {
  active
  suspended
  // D95: archivada. Sin acceso ni motores; los datos se conservan hasta `archive_until` y entonces se borran por completo.
  deactivated

  @@map("company_status")

  @@schema("platform")
}

// D95: por qué se archiva una empresa (company_deactivation_reason en enums.md).
enum CompanyDeactivationReason {
  non_payment
  client_request
  other

  @@map("company_deactivation_reason")

  @@schema("platform")
}

enum AccessKeyStatus {
  pending
  used
  expired
  revoked

  @@map("access_key_status")

  @@schema("platform")
}

model Company {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  adminEmail        String            @map("admin_email")
  isolationStrategy IsolationStrategy @default(shared) @map("isolation_strategy")
  status            CompanyStatus     @default(active)
  // D95: solo con status = deactivated. Se vacían al reactivar (el plazo deja de existir).
  deactivatedAt          DateTime?                  @map("deactivated_at")
  archiveUntil           DateTime?                  @map("archive_until")
  deactivationReasonCode CompanyDeactivationReason? @map("deactivation_reason_code")
  deactivationReason     String?                    @map("deactivation_reason")
  deactivatedBy          String?                    @map("deactivated_by") @db.Uuid
  // Dónde está la copia cifrada que se toma al archivar (se borra con el resto, D95).
  archiveSnapshotKey     String?                    @map("archive_snapshot_key")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  accessKeys AccessKey[]
  frameworks CompanyFramework[]
  users      User[]
  apiKeys    ApiKey[]
  consultantAssignments ConsultantAssignment[]
  organization              Organization?
  organizationRegulations   OrganizationRegulation[]
  organizationResponsibles  OrganizationResponsible[]
  services                  Service[]
  serviceTrustCriteria      ServiceTrustCriterion[]
  sessions               Session[]
  userActivationCodes    UserActivationCode[]
  serviceFrameworks         ServiceFramework[]
  subserviceOrganizations   SubserviceOrganization[]
  csocs                     Csoc[]
  cuecs                     Cuec[]
  systemDescriptions        SystemDescription[]
  clientRisks               ClientRisk[]
  clientCauses              ClientCause[]
  clientRiskCauses          ClientRiskCause[]
  clientCauseControls       ClientCauseControl[]
  assets                    Asset[]
  serviceAssets             ServiceAsset[]
  assetProvisionings        AssetProvisioning[]
  clientControls        ClientControl[]
  clientControlChanges  ClientControlChange[]
  clientControlDimensions ClientControlDimension[]
  clientControlTests    ClientControlTest[]
  userControlAssignments UserControlAssignment[]
  actionPlans           ActionPlan[]
  mitigations           Mitigation[]
  residualRisks         ResidualRisk[]
  riskTreatments        RiskTreatment[]
  evidenceRequirements  EvidenceRequirement[]
  evidenceSubmissions   EvidenceSubmission[]
  evidenceReviews       EvidenceReview[]
  frameworkAssessments  FrameworkAssessment[]
  exclusions            Exclusion[]
  evaluations           Evaluation[]
  findings              Finding[]
  vulnerabilities       Vulnerability[]
  scheduleRules  ScheduleRule[]
  executions     Execution[]
  checkResults   CheckResult[]
  assetResources AssetResource[]
  executionLogs  ExecutionLog[]
  auditLogs        AuditLog[]
  complianceEvents ComplianceEvent[]

  @@map("companies")
  @@schema("platform")
}

// Los marcos que Monkey Admin contrató para una empresa al registrarla (D47). Solo admin_monkey
// escribe; la empresa lo lee. Al declarar un servicio, el cliente solo puede elegir entre estos
// (service_frameworks sigue guardando qué marco persigue cada servicio y desde qué versión).
model CompanyFramework {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  frameworkId  String   @map("framework_id") @db.Uuid
  contractedBy String   @map("contracted_by") @db.Uuid
  contractedAt DateTime @map("contracted_at") @db.Date

  company          Company   @relation(fields: [companyId], references: [id])
  framework        Framework @relation(fields: [frameworkId], references: [id])
  contractedByUser User      @relation(fields: [contractedBy], references: [id])

  @@unique([companyId, frameworkId])
  @@index([frameworkId])
  @@index([contractedBy])
  @@map("company_frameworks")
  @@schema("platform")
}

model AccessKey {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @map("company_id") @db.Uuid
  createdBy String          @map("created_by") @db.Uuid
  codeHash  String          @unique @map("code_hash") // se busca por hash al canjear la clave
  status    AccessKeyStatus @default(pending)
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")

  company Company @relation(fields: [companyId], references: [id])
  createdByUser User @relation(fields: [createdBy], references: [id])

  @@index([companyId])
  @@map("access_keys")
  @@schema("platform")
}

// D95: lo único que queda de una empresa borrada definitivamente — nombre, cuándo y quién (el sistema, por vencimiento; y quien la archivó).
// Sin datos del cliente y sin clave foránea a `companies` (esa fila ya no existe). La escribe `platform.purge_company`, no la app.
model CompanyPurgeLog {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  companyName String    @map("company_name")
  purgedAt    DateTime  @default(now()) @map("purged_at")
  archivedBy  String?   @map("archived_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at")

  @@index([purgedAt])
  @@map("company_purge_log")
  @@schema("platform")
}

enum EvaluationResult {
  compliant
  non_compliant
  pending
  not_applicable

  @@map("evaluation_result")

  @@schema("tenant")
}

enum RawProbeResult {
  ok
  fail

  @@map("raw_probe_result")

  @@schema("tenant")
}

enum FindingStatus {
  open
  remediated
  excluded

  @@map("finding_status")

  @@schema("tenant")
}

enum FindingOrigin {
  system
  auditor

  @@map("finding_origin")

  @@schema("tenant")
}

enum RiskTreatmentDecision {
  mitigate
  accept
  transfer
  avoid

  @@map("risk_treatment_decision")

  @@schema("tenant")
}

enum VulnerabilityStatus {
  active
  solved
  mitigated

  @@map("vulnerability_status")

  @@schema("tenant")
}

// Quién produjo la evaluación: la sonda (R-04), el admin_empresa con evidencia (R-03) o la revisión documental con IA (§2, dimensión policy).
enum EvaluationOrigin {
  automated
  manual
  ai_assisted

  @@map("evaluation_origin")
  @@schema("tenant")
}

// Severidad de un hallazgo o de una vulnerabilidad (CVSS: 0.1-3.9 low, 4.0-6.9 medium, 7.0-8.9 high, 9.0-10 critical).
enum Severity {
  low
  medium
  high
  critical

  @@map("severity")
  @@schema("tenant")
}

model ClientControl {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  // Plantilla de origen (catalog.controls). Null en un control que el cliente creó desde cero (D36):
  // por eso evaluations y evidence_requirements cuelgan de ESTA tabla, no del catálogo.
  controlId            String?              @map("control_id") @db.Uuid
  serviceId            String               @map("service_id") @db.Uuid
  // El código del catálogo (`IAC-12`) en un control clonado; la numeración propia (`C01`) en uno que creó la empresa. El código del catálogo es técnico:
  // la API no lo muestra al cliente.
  ownCode              String               @map("own_code")
  // Solo en un control propio (D79): en uno del catálogo salen de `controls.name` y de sus requisitos. Un CHECK exige ambos cuando `control_id` es nulo.
  name                 String?
  trustCriterion       TrustCriterionCode?  @map("trust_criterion")
  clientInterpretation String               @map("client_interpretation") @db.Text
  type                 ControlDimensionType // manual|automated|hybrid|technical_manual
  sourceRef            String?              @map("source_ref")
  // Eliminar es dar de baja, no borrar: las evaluaciones son inmutables y las FK son RESTRICT.
  isActive             Boolean              @default(true) @map("is_active")
  // MD-500, D147 · El último cambio de periodicidad del control (G-10). `periodicityChangedAt` nulo = usa la sugerida del catálogo.
  periodicityJustification String?          @map("periodicity_justification") @db.Text
  periodicityChangedAt     DateTime?        @map("periodicity_changed_at")
  periodicityChangedBy     String?          @map("periodicity_changed_by") @db.Uuid

  control Control? @relation(fields: [controlId], references: [id], onDelete: Restrict)
  service Service  @relation(fields: [serviceId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])

  assignment ClientControlAssignment?
  clientCauseControls   ClientCauseControl[]
  evaluations           Evaluation[]
  controlApprovals      ControlApproval[]
  manualTestResults     ManualTestResult[]
  auditObservations     AuditObservation[]
  evidenceRequirements  EvidenceRequirement[]
  dimensions            ClientControlDimension[]
  tests                 ClientControlTest[]
  requirements          ClientControlRequirement[]
  changes               ClientControlChange[]
  levelOverrides       ControlLevelOverride[]
  remediationPlans     RemediationPlan[]

  // Un control del catálogo se clona una sola vez por servicio (idempotencia del clonado, MD-80).
  // Los propios (control_id nulo) no chocan entre sí: en Postgres los nulos son distintos.
  @@unique([serviceId, controlId])
  @@unique([serviceId, ownCode])
  @@index([tenantId])
  @@index([controlId])
  @@map("client_controls")
  @@schema("tenant")
}

enum ClientCauseControlEffect {
  probability
  impact

  @@map("cause_control_effect")
  @@schema("tenant")
}

enum ClientControlChangeType {
  create
  retire
  edit_dimensions
  edit_interpretation

  @@map("client_control_change_type")
  @@schema("tenant")
}

enum ClientControlChangeStatus {
  pending
  approved
  rejected

  @@map("client_control_change_status")
  @@schema("tenant")
}

// Crear un control propio, darlo de baja o editar sus dimensiones o su interpretación son PROPUESTAS de la empresa (D65, §7.1; D96 las vuelve cambios directos del admin_empresa: ver `compliance-controls.md`).
// Mientras está pendiente, el control sigue como estaba (y contando). Una por tipo y por control a la vez: lo impone un índice único parcial en la migración.
model ClientControlChange {
  id              String                    @id @default(uuid()) @db.Uuid
  tenantId        String                    @map("tenant_id") @db.Uuid
  serviceId       String                    @map("service_id") @db.Uuid
  clientControlId String                    @map("client_control_id") @db.Uuid
  changeType      ClientControlChangeType   @map("change_type")
  proposedValues  Json                      @map("proposed_values")
  status          ClientControlChangeStatus @default(pending)
  requestedBy     String                    @map("requested_by") @db.Uuid
  decidedBy       String?                   @map("decided_by") @db.Uuid
  decisionNote    String?                   @map("decision_note") @db.Text
  requestedAt     DateTime                  @default(now()) @map("requested_at")
  decidedAt       DateTime?                 @map("decided_at")

  clientControl   ClientControl @relation(fields: [clientControlId], references: [id])
  service         Service       @relation(fields: [serviceId], references: [id])
  requestedByUser User          @relation("ControlChangeRequestedBy", fields: [requestedBy], references: [id])
  decidedByUser   User?         @relation("ControlChangeDecidedBy", fields: [decidedBy], references: [id], onDelete: Restrict)
  tenant          Company       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([serviceId, status])
  @@index([clientControlId])
  @@map("client_control_changes")
  @@schema("tenant")
}

model Mitigation {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  // Exactamente uno de los dos es no nulo (CHECK en la migración).
  clientCauseId      String?  @map("client_cause_id") @db.Uuid
  clientRiskId       String?  @map("client_risk_id") @db.Uuid
  responsePercentage Decimal  @map("response_percentage") @db.Decimal(5, 2)
  calculatedAt       DateTime @map("calculated_at") @db.Date

  // Restrict: con el CHECK "exactamente uno", un SET NULL dejaría la fila inválida.
  clientCause ClientCause? @relation(fields: [clientCauseId], references: [id], onDelete: Restrict)
  clientRisk  ClientRisk?  @relation(fields: [clientRiskId], references: [id], onDelete: Restrict)
  tenant      Company      @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientCauseId])
  @@index([clientRiskId])
  @@map("mitigations")
  @@schema("tenant")
}

model ResidualRisk {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  clientRiskId  String   @map("client_risk_id") @db.Uuid
  acceptedBy    String   @map("accepted_by") @db.Uuid
  residualLevel RiskLevel @map("residual_level")
  justification String   @db.Text
  acceptedAt    DateTime @map("accepted_at") @db.Date

  clientRisk     ClientRisk @relation(fields: [clientRiskId], references: [id])
  acceptedByUser User    @relation(fields: [acceptedBy], references: [id])
  tenant         Company @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientRiskId])
  @@map("residual_risks")
  @@schema("tenant")
}

// El tratamiento de un riesgo: una decisión por fila, la vigente es la última (MD-123). El responsable es un CARGO de la organización (D30), no una persona con cuenta.
model RiskTreatment {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  clientRiskId  String                @map("client_risk_id") @db.Uuid
  responsibleId String                @map("responsible_id") @db.Uuid
  decision      RiskTreatmentDecision
  dueDate       DateTime              @map("due_date") @db.Date
  // Quién registró la decisión; RESTRICT: el histórico no pierde atribución.
  createdBy     String                @map("created_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")

  clientRisk    ClientRisk              @relation(fields: [clientRiskId], references: [id])
  responsible   OrganizationResponsible @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  createdByUser User                    @relation("RiskTreatmentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  tenant        Company                 @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientRiskId, createdAt])
  @@index([responsibleId])
  @@map("risk_treatments")
  @@schema("tenant")
}

model EvidenceRequirement {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  clientControlId      String    @map("client_control_id") @db.Uuid
  responsibleId        String?   @map("responsible_id") @db.Uuid // cargo, no persona (A1)
  code                 String
  sequence             Int
  description          String    @db.Text
  dimension            Dimension
  // D88: la prueba documental de ESTE control a la que sirve la evidencia. Nulo = compartida con todas las pruebas documentales del control.
  testId               String?   @map("test_id") @db.Uuid
  validityWithinPeriod String    @map("validity_within_period")
  sourceRef            String?   @map("source_ref") // código de la plantilla (catalog.evidence_templates); null si la creó el cliente

  clientControl ClientControl          @relation(fields: [clientControlId], references: [id])
  responsible OrganizationResponsible? @relation(fields: [responsibleId], references: [id])
  test        Test?                    @relation(fields: [testId], references: [id], onDelete: Restrict)
  tenant      Company                  @relation(fields: [tenantId], references: [id])

  submissions EvidenceSubmission[]

  @@unique([clientControlId, code])
  @@index([tenantId])
  @@index([clientControlId])
  @@index([responsibleId])
  @@index([testId])
  @@map("evidence_requirements")
  @@schema("tenant")
}

model EvidenceSubmission {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  evidenceRequirementId  String   @map("evidence_requirement_id") @db.Uuid
  submittedBy            String   @map("submitted_by") @db.Uuid // admin_empresa, responsable o delegado: la empresa solo aporta, no aprueba (D84)
  submittedAt            DateTime @default(now()) @map("submitted_at")
  filePath               String   @map("file_path") // la llave del objeto en el almacenamiento privado
  fileType               String   @map("file_type")
  fileSize               Int      @map("file_size")
  storageLocation        String   @map("storage_location")
  integrityHash          String   @map("integrity_hash")
  version                String // entero creciente por requerimiento, guardado como texto (§7.3); una versión nueva nunca pisa la anterior
  aiVerdict              String?  @map("ai_verdict") @db.Text // siempre etiquetado como generado por IA
  // MD-504 (D132) · La devolución del control que dejó esta entrega sin contar: nulo = no fue devuelta. Es la única marca; el motivo y quién la devolvió salen de `control_approvals`.
  returnedApprovalId     String?  @map("returned_approval_id") @db.Uuid
  // MD-529 (DT-115) · La ocurrencia de un requisito «cuando sea requerido» que prueba esta entrega.
  requirementOccurrenceId String?                @map("requirement_occurrence_id") @db.Uuid
  requirementOccurrence   RequirementOccurrence? @relation(fields: [requirementOccurrenceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  returnedApproval       ControlApproval? @relation("ApprovalReturnedSubmissions", fields: [returnedApprovalId], references: [id])

  evidenceRequirement EvidenceRequirement @relation(fields: [evidenceRequirementId], references: [id])
  submittedByUser     User                @relation("EvidenceSubmittedBy", fields: [submittedBy], references: [id])
  tenant              Company             @relation(fields: [tenantId], references: [id])


  observations       AuditObservation[] @relation("ObservationEvidence")
  observationAnswers AuditObservation[] @relation("ObservationAnswerEvidence")

  @@unique([evidenceRequirementId, version])
  @@index([tenantId])
  @@index([evidenceRequirementId])
  @@index([returnedApprovalId])
  @@index([requirementOccurrenceId])
  @@map("evidence_submissions")
  @@schema("tenant")
}

enum ExclusionStatus {
  pending
  approved
  rejected

  @@map("exclusion_status")
  @@schema("tenant")
}

// Excluir un ACTIVO de un test (o un check) cambia lo que se mide: la propone y la decide `admin_empresa` en un solo acto (D96): nace `approved`. `pending` y `rejected` quedan sin uso.
// `asset_id` nulo y `excluded_check_id` con valor es la exclusión de un check; hoy el contrato solo expone la de un activo (MD-144).
model Exclusion {
  id                     String          @id @default(uuid()) @db.Uuid
  tenantId               String          @map("tenant_id") @db.Uuid
  serviceId              String          @map("service_id") @db.Uuid
  testId                 String          @map("test_id") @db.Uuid
  assetId                String?         @map("asset_id") @db.Uuid
  proposedBy             String          @map("proposed_by") @db.Uuid // admin_empresa
  decidedBy              String?         @map("decided_by") @db.Uuid // el admin_empresa que la decide
  status                 ExclusionStatus @default(pending)
  requestedAt            DateTime        @default(now()) @map("requested_at")
  decidedAt              DateTime?       @map("decided_at")
  decisionNote           String?         @map("decision_note") @db.Text
  technicalJustification String?         @map("technical_justification") @db.Text
  excludedCheckId        String?         @map("excluded_check_id")
  justification          String          @db.Text
  validFrom              DateTime        @map("valid_from") @db.Date
  validUntil             DateTime        @map("valid_until") @db.Date
  expiredAt              DateTime?       @map("expired_at") @db.Timestamptz(3) // MD-501 · timestamptz a propósito (el resto de la tabla es timestamp(3)); la migración ya está aplicada, no se edita · cuándo la tarea diaria registró el vencimiento

  service        Service @relation(fields: [serviceId], references: [id])
  test           Test    @relation(fields: [testId], references: [id])
  asset          Asset?  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  proposedByUser User    @relation("ExclusionProposedBy", fields: [proposedBy], references: [id])
  decidedByUser  User?   @relation("ExclusionDecidedBy", fields: [decidedBy], references: [id], onDelete: Restrict)
  tenant         Company @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([serviceId])
  @@index([testId])
  @@index([assetId])
  @@map("exclusions")
  @@schema("tenant")
}

enum AuditObservationType {
  observation
  recommendation
  information_request

  @@map("audit_observation_type")
  @@schema("tenant")
}

enum AuditObservationStatus {
  open
  answered
  closed

  @@map("audit_observation_status")
  @@schema("tenant")
}

// §7.6, MD-154 · Lo que redacta el `auditor` y debe atender la empresa. NO es un hallazgo (lo detecta el sistema) y NO mueve el porcentaje. `open` → `answered` → `closed`:
// responde el `admin_empresa` (o el `responsable` dueño del control); solo cierra, o devuelve a `open`, quien la escribió. Una cerrada no se toca y ninguna se borra: la base lo impone
// con un trigger (ver la migración de RLS). `client_control_id` se completa solo cuando solo se manda la evidencia (la entrega pertenece a un único control). Al devolverla a `open`
// la última respuesta se conserva; la anterior queda en `audit_logs`.
model AuditObservation {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String                 @map("tenant_id") @db.Uuid
  serviceId            String                 @map("service_id") @db.Uuid
  clientControlId      String?                @map("client_control_id") @db.Uuid
  evidenceSubmissionId String?                @map("evidence_submission_id") @db.Uuid
  createdBy            String                 @map("created_by") @db.Uuid // el auditor que la escribe
  type                 AuditObservationType
  body                 String                 @db.Text
  status               AuditObservationStatus @default(open)
  answerNote           String?                @map("answer_note") @db.Text
  answerEvidenceId     String?                @map("answer_evidence_id") @db.Uuid
  answeredBy           String?                @map("answered_by") @db.Uuid
  answeredAt           DateTime?              @map("answered_at")
  closedBy             String?                @map("closed_by") @db.Uuid // siempre quien la escribió
  closedAt             DateTime?              @map("closed_at")
  createdAt            DateTime               @default(now()) @map("created_at")

  service        Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clientControl  ClientControl?      @relation(fields: [clientControlId], references: [id], onDelete: Restrict)
  evidence       EvidenceSubmission? @relation("ObservationEvidence", fields: [evidenceSubmissionId], references: [id], onDelete: Restrict)
  answerEvidence EvidenceSubmission? @relation("ObservationAnswerEvidence", fields: [answerEvidenceId], references: [id], onDelete: Restrict)
  createdByUser  User                @relation("ObservationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  answeredByUser User?               @relation("ObservationAnsweredBy", fields: [answeredBy], references: [id], onDelete: Restrict)
  closedByUser   User?               @relation("ObservationClosedBy", fields: [closedBy], references: [id], onDelete: Restrict)
  tenant         Company             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([serviceId, status])
  @@index([clientControlId, status])
  @@index([evidenceSubmissionId])
  @@map("audit_observations")
  @@schema("tenant")
}

// Inmutable (§7.4): una evaluación nueva se agrega, nunca pisa la anterior. Por eso no lleva updatedAt.
// El rol de la app solo puede UPDATE de `confirmed_by` y `closure_observation_reason` (el cierre
// humano de §7.5) y no puede DELETE: se impone con GRANT por columna, ver la migración de RLS.
model Evaluation {
  id                       String           @id @default(uuid()) @db.Uuid
  tenantId                 String           @map("tenant_id") @db.Uuid
  serviceId                String           @map("service_id") @db.Uuid
  // El control DEL CLIENTE que se evaluó (D36). Su service_id debe ser el de esta fila: regla de aplicación.
  clientControlId          String           @map("client_control_id") @db.Uuid
  // Qué se evaluó: el test (siempre) y, si lo midió la sonda, el check exacto. Sin esto
  // no se puede señalar "el activo y el check exactos" de una falla (§9) ni aplicar
  // exclusiones (que son por test + check).
  testId                   String           @map("test_id") @db.Uuid
  checkId                  String?          @map("check_id") @db.Uuid
  assetId                  String           @map("asset_id") @db.Uuid
  catalogVersionId         String           @map("catalog_version_id") @db.Uuid
  confirmedBy              String?          @map("confirmed_by") @db.Uuid
  // Instante, no día: la sonda corre cada 6 h y "la última evaluación" tiene que ser inequívoca.
  evaluatedAt              DateTime         @default(now()) @map("evaluated_at")
  dimension                Dimension
  result                   EvaluationResult
  rawProbeResult           RawProbeResult?  @map("raw_probe_result")
  diagnosticPercentage     Decimal?         @map("diagnostic_percentage") @db.Decimal(5, 2)
  origin                   EvaluationOrigin
  clientResponse           String?          @map("client_response") @db.Text
  verdictNote              String?          @map("verdict_note") @db.Text
  closureObservationReason String?          @map("closure_observation_reason") @db.Text
  coveredPeriod            String?          @map("covered_period")

  service        Service        @relation(fields: [serviceId], references: [id])
  clientControl  ClientControl  @relation(fields: [clientControlId], references: [id])
  test           Test           @relation(fields: [testId], references: [id])
  check          Check?         @relation(fields: [checkId], references: [id])
  asset          Asset          @relation(fields: [assetId], references: [id])
  catalogVersion CatalogVersion @relation(fields: [catalogVersionId], references: [id])
  confirmedByUser User?         @relation(fields: [confirmedBy], references: [id], onDelete: Restrict)
  tenant         Company        @relation(fields: [tenantId], references: [id])

  findings Finding[]

  // Además, el índice parcial `evaluations_latest_idx` (solo en la migración 20261119000100: Prisma no declara índices parciales).
  @@index([serviceId, clientControlId, evaluatedAt])
  @@index([assetId])
  @@index([tenantId])
  @@index([catalogVersionId])
  @@index([checkId])
  @@index([clientControlId])
  @@index([testId])
  @@map("evaluations")
  @@schema("tenant")
}

model Finding {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  evaluationId       String        @map("evaluation_id") @db.Uuid
  assetId            String        @map("asset_id") @db.Uuid
  reportedBy         String?       @map("reported_by") @db.Uuid // null si lo abrió el sistema
  dimension          Dimension
  failedTestOrCheck  String        @map("failed_test_or_check")
  severity           Severity
  status             FindingStatus @default(open)
  origin             FindingOrigin
  detectedAt         DateTime      @map("detected_at") @db.Date
  closedAt           DateTime?     @map("closed_at") @db.Date

  evaluation     Evaluation @relation(fields: [evaluationId], references: [id])
  asset          Asset      @relation(fields: [assetId], references: [id])
  reportedByUser User?      @relation(fields: [reportedBy], references: [id], onDelete: Restrict)
  tenant         Company    @relation(fields: [tenantId], references: [id])

  @@index([evaluationId])
  @@index([assetId])
  @@index([tenantId])
  @@map("findings")
  @@schema("tenant")
}

model Vulnerability {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  assetId        String              @map("asset_id") @db.Uuid
  cve            String
  severity       Severity
  packageName    String              @map("package_name")
  packageVersion String              @map("package_version")
  cvssScore      Decimal             @map("cvss_score") @db.Decimal(3, 1)
  status         VulnerabilityStatus @default(active)
  recommendation String              @db.Text

  asset  Asset   @relation(fields: [assetId], references: [id])
  tenant Company @relation(fields: [tenantId], references: [id])

  @@unique([assetId, cve, packageName])
  @@index([tenantId])
  @@map("vulnerabilities")
  @@schema("tenant")
}

// ---------------------------------------------------------------------------------------------
// Riesgos y causas DEL CLIENTE (D28). El catálogo (catalog.risks / catalog.causes) es solo la
// plantilla: al contratar un marco se copian aquí, por servicio, y el cliente las edita, agrega o
// elimina sin que el catálogo ni otro cliente se enteren. `riskId` / `causeId` guardan la
// plantilla de origen y son null en lo que el cliente creó desde cero.
// ---------------------------------------------------------------------------------------------
model ClientRisk {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  serviceId         String             @map("service_id") @db.Uuid
  riskId            String?            @map("risk_id") @db.Uuid
  code              String
  name              String
  description       String             @db.Text
  trustCriterion    RiskCriterion      @map("trust_criterion")
  potentialImpact   Json               @map("potential_impact")
  // Los llena el cliente al evaluar el riesgo en la matriz 5×5 (el catálogo los trae vacíos).
  likelihood        Int?
  impact            Int?
  inherentRiskValue Int?               @map("inherent_risk_value")
  inherentRiskLevel RiskLevel?         @map("inherent_risk_level")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id])
  risk    Risk?   @relation(fields: [riskId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])

  riskCauses     ClientRiskCause[]
  mitigations    Mitigation[]
  residualRisks  ResidualRisk[]
  riskTreatments RiskTreatment[]

  @@unique([serviceId, code])
  @@unique([serviceId, riskId])
  @@index([tenantId])
  @@index([riskId])
  @@map("client_risks")
  @@schema("tenant")
}

model ClientCause {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  serviceId       String          @map("service_id") @db.Uuid
  causeId         String?         @map("cause_id") @db.Uuid
  code            String
  name            String?
  failureCategory FailureCategory? @map("failure_category")
  origin          CauseOrigin?
  causeType       CauseType?      @map("cause_type")
  description     String          @db.Text
  isActive        Boolean         @default(true) @map("is_active") // baja lógica, como client_risks
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id])
  cause   Cause?  @relation(fields: [causeId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])

  riskCauses    ClientRiskCause[]
  causeControls ClientCauseControl[]
  mitigations   Mitigation[]

  @@unique([serviceId, code])
  @@unique([serviceId, causeId])
  @@index([tenantId])
  @@index([causeId])
  @@map("client_causes")
  @@schema("tenant")
}

model ClientRiskCause {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  clientRiskId  String @map("client_risk_id") @db.Uuid
  clientCauseId String @map("client_cause_id") @db.Uuid

  clientRisk  ClientRisk  @relation(fields: [clientRiskId], references: [id])
  clientCause ClientCause @relation(fields: [clientCauseId], references: [id])
  tenant      Company     @relation(fields: [tenantId], references: [id])

  @@unique([clientRiskId, clientCauseId])
  @@index([tenantId])
  @@index([clientCauseId])
  @@map("client_risk_causes")
  @@schema("tenant")
}

// Replica cause_controls, pero apuntando al control DEL CLIENTE (client_controls), que es el que
// él particulariza.
model ClientCauseControl {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  clientCauseId   String @map("client_cause_id") @db.Uuid
  clientControlId String @map("client_control_id") @db.Uuid
  // D75: un control obligatorio de la causa, y si reduce la probabilidad o el impacto. Hoy solo 9 de las 209 relaciones del comité traen el efecto (`P22`):
  // el resto queda en null y no participa del riesgo residual.
  isMandatory     Boolean                @default(true) @map("is_mandatory")
  effect          ClientCauseControlEffect?

  clientCause   ClientCause   @relation(fields: [clientCauseId], references: [id])
  clientControl ClientControl @relation(fields: [clientControlId], references: [id])
  tenant        Company       @relation(fields: [tenantId], references: [id])

  @@unique([clientCauseId, clientControlId])
  @@index([tenantId])
  @@index([clientControlId])
  @@map("client_cause_controls")
  @@schema("tenant")
}


// Copia por cliente de control_dimensions (D36): qué dimensiones aplica su control, con qué tipo y
// banderas, y la razón si una no aplica. Un control propio declara las suyas aquí.
model ClientControlDimension {
  id                             String               @id @default(uuid()) @db.Uuid
  tenantId                       String               @map("tenant_id") @db.Uuid
  clientControlId                String               @map("client_control_id") @db.Uuid
  dimension                      Dimension
  type                           ControlDimensionType
  requiresProbe                  Boolean              @default(false) @map("requires_probe")
  requiresAi                     Boolean              @default(false) @map("requires_ai")
  requiresComplianceConfirmation Boolean              @default(false) @map("requires_compliance_confirmation")
  reasonNotApplicable            String?              @map("reason_not_applicable") @db.Text

  clientControl ClientControl @relation(fields: [clientControlId], references: [id])
  tenant        Company       @relation(fields: [tenantId], references: [id])

  @@unique([clientControlId, dimension])
  @@index([tenantId])
  @@map("client_control_dimensions")
  @@schema("tenant")
}

// El requisito del control del cliente (MD-498, modelo-datos.md §7.0): una fila por cada `catalog.control_requirements` del control que el servicio heredó, creada al clonar el servicio.
// No guarda estado: el del requisito se deriva en cada lectura (§9). `periodicity` se copia del catálogo y la cambia el `admin_empresa` (MD-500); el «No aplica» justificado llega con la gestión (RC-07).
model ClientControlRequirement {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  clientControlId      String       @map("client_control_id") @db.Uuid
  controlRequirementId String       @map("control_requirement_id") @db.Uuid
  periodicity          Periodicity?
  isApplicable         Boolean      @default(true) @map("is_applicable")
  notApplicableReason  String?      @map("not_applicable_reason") @db.Text
  createdAt            DateTime     @default(now()) @map("created_at")

  clientControl      ClientControl      @relation(fields: [clientControlId], references: [id])
  controlRequirement ControlRequirement @relation(fields: [controlRequirementId], references: [id], onDelete: Restrict)
  tenant             Company            @relation(fields: [tenantId], references: [id])

  remediationPlans         RemediationPlan[]
  applicabilityRequests    RequirementApplicabilityRequest[]
  occurrences              RequirementOccurrence[]
  noOccurrenceDeclarations NoOccurrenceDeclaration[]

  @@unique([clientControlId, controlRequirementId])
  @@index([tenantId])
  @@index([controlRequirementId])
  @@map("client_control_requirements")
  @@schema("tenant")
}

// Copia por cliente del vínculo control ↔ test (D36). Los tests en sí NO se clonan: se referencian.
model ClientControlTest {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  clientControlId String @map("client_control_id") @db.Uuid
  testId          String @map("test_id") @db.Uuid

  clientControl ClientControl @relation(fields: [clientControlId], references: [id])
  test          Test          @relation(fields: [testId], references: [id])
  tenant        Company       @relation(fields: [tenantId], references: [id])

  @@unique([clientControlId, testId])
  @@index([tenantId])
  @@index([testId])
  @@map("client_control_tests")
  @@schema("tenant")
}

// Quién emite una evaluación del servicio (D77, en pausa por D96 y P35): solo el auditor certifica.
enum AssessorRole {
  auditor

  @@map("assessor_role")
  @@schema("tenant")
}

// El auditor certifica o no (un CHECK de la base lo impone, SEG-56).
enum AssessmentVerdict {
  certified
  not_certified

  @@map("assessment_verdict")
  @@schema("tenant")
}

// La evaluación del auditor sobre un servicio y un marco (modelo-datos.md §7.5, D77, MD-155; en pausa por D96 y P35). Inmutable una vez emitida: para cambiar de opinión se
// emite otra y la vigente es la última sobre esa evaluación del servicio. No cambia el estado calculado.
model FrameworkAssessment {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  serviceFrameworkId String            @map("service_framework_id") @db.Uuid
  assessorRole       AssessorRole      @map("assessor_role")
  verdict            AssessmentVerdict
  rationale          String            @db.Text
  issuedBy           String            @map("issued_by") @db.Uuid
  issuedAt           DateTime          @default(now()) @map("issued_at")

  serviceFramework ServiceFramework @relation(fields: [serviceFrameworkId], references: [id])
  issuedByUser     User             @relation("AssessmentIssuedBy", fields: [issuedBy], references: [id])
  tenant           Company          @relation(fields: [tenantId], references: [id])

  @@index([serviceFrameworkId, assessorRole, issuedAt])
  @@index([tenantId])
  @@index([issuedBy])
  @@map("framework_assessments")
  @@schema("tenant")
}

enum ControlApprovalStep {
  owner
  final

  @@map("control_approval_step")
  @@schema("tenant")
}

enum ControlApprovalDecision {
  approved
  returned

  @@map("control_approval_decision")
  @@schema("tenant")
}

// MD-504 (D132) · Cada aprobación o devolución del control (aprobación del responsable y final del admin_empresa). Inmutable salvo `invalidated_at`, que se escribe una vez cuando la
// aprobación deja de valer (el control dejó de cumplir, o se devolvió). `window_start` es el inicio de la ventana del control cuando se dio: otra ventana, otra aprobación.
model ControlApproval {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  clientControlId String                  @map("client_control_id") @db.Uuid
  step            ControlApprovalStep
  decision        ControlApprovalDecision
  reason          String?                 @db.Text
  actorId         String                  @map("actor_id") @db.Uuid
  at              DateTime                @default(now())
  windowStart     DateTime?               @map("window_start")
  invalidatedAt   DateTime?               @map("invalidated_at")

  clientControl      ClientControl        @relation(fields: [clientControlId], references: [id])
  actor              User                 @relation("ControlApprovalActor", fields: [actorId], references: [id])
  tenant             Company              @relation(fields: [tenantId], references: [id])
  returnedSubmissions EvidenceSubmission[] @relation("ApprovalReturnedSubmissions")

  @@index([tenantId])
  @@index([clientControlId, at(sort: Desc)])
  @@index([actorId])
  @@map("control_approvals")
  @@schema("tenant")
}

enum ManualTestResultValue {
  correct
  observation
  exception

  @@map("manual_test_result_value")
  @@schema("tenant")
}

// MD-504 (D140 puntos 1 y 2, D129) · El resultado que el responsable registra de una prueba manual EN ESE control. Inmutable: cada registro es una fila nueva y el último de la ventana
// vigente decide. Reemplaza a `test_verdicts` (D85) para lo manual.
model ManualTestResult {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  clientControlId String                @map("client_control_id") @db.Uuid
  testId          String                @map("test_id") @db.Uuid
  result          ManualTestResultValue
  note            String?               @db.Text
  registeredBy    String                @map("registered_by") @db.Uuid
  registeredAt    DateTime              @default(now()) @map("registered_at")

  clientControl    ClientControl @relation(fields: [clientControlId], references: [id])
  test             Test          @relation(fields: [testId], references: [id])
  registeredByUser User          @relation("ManualTestResultRegisteredBy", fields: [registeredBy], references: [id])
  tenant           Company       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientControlId, testId, registeredAt(sort: Desc)])
  @@index([testId])
  @@index([registeredBy])
  @@map("manual_test_results")
  @@schema("tenant")
}

// MD-529 (D135, D140 puntos 3 y 4, D131 punto 3; contracts/cumplimiento/aprobacion.md) · Corrección del nivel (R5), plan de remediación por excepción, solicitud de «No aplica» de un requisito,
// ocurrencias de los requisitos «cuando sea requerido» y su declaración trimestral. Las relaciones espejan las claves foráneas de la migración (mismos nombres y acciones).
enum ChangeRequestStatus {
  pending
  approved
  rejected

  @@map("change_request_status")
  @@schema("tenant")
}

model ControlLevelOverride {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  clientControlId String              @map("client_control_id") @db.Uuid
  suggestedLevel  Int                 @map("suggested_level") @db.SmallInt
  proposedLevel   Int                 @map("proposed_level") @db.SmallInt
  justification   String              @db.Text
  status          ChangeRequestStatus @default(pending)
  proposedBy      String              @map("proposed_by") @db.Uuid
  proposedAt      DateTime            @default(now()) @map("proposed_at")
  decidedBy       String?             @map("decided_by") @db.Uuid
  decidedAt       DateTime?           @map("decided_at")
  decisionReason  String?             @map("decision_reason") @db.Text
  windowStart     DateTime?           @map("window_start")
  invalidatedAt   DateTime?           @map("invalidated_at")
  decidedDirectly Boolean             @default(false) @map("decided_directly")

  clientControl  ClientControl @relation(fields: [clientControlId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant         Company       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  proposedByUser User          @relation("LevelOverrideProposedBy", fields: [proposedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedByUser  User?         @relation("LevelOverrideDecidedBy", fields: [decidedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId])
  @@index([clientControlId, proposedAt(sort: Desc)], map: "control_level_overrides_control_idx")
  @@index([proposedBy])
  @@index([decidedBy])
  @@map("control_level_overrides")
  @@schema("tenant")
}

model RemediationPlan {
  id                         String              @id @default(uuid()) @db.Uuid
  tenantId                   String              @map("tenant_id") @db.Uuid
  clientControlId            String              @map("client_control_id") @db.Uuid
  testId                     String              @map("test_id") @db.Uuid
  clientControlRequirementId String?             @map("client_control_requirement_id") @db.Uuid
  what                       String              @db.Text
  assigneeId                 String              @map("assignee_id") @db.Uuid
  dueDate                    DateTime            @map("due_date") @db.Date
  status                     ChangeRequestStatus @default(pending)
  proposedBy                 String              @map("proposed_by") @db.Uuid
  proposedAt                 DateTime            @default(now()) @map("proposed_at")
  decidedBy                  String?             @map("decided_by") @db.Uuid
  decidedAt                  DateTime?           @map("decided_at")
  decisionReason             String?             @map("decision_reason") @db.Text
  windowStart                DateTime?           @map("window_start")
  invalidatedAt              DateTime?           @map("invalidated_at")
  decidedDirectly            Boolean             @default(false) @map("decided_directly")

  clientControl  ClientControl             @relation(fields: [clientControlId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant         Company                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  test           Test                      @relation(fields: [testId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requirement    ClientControlRequirement? @relation(fields: [clientControlRequirementId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "remediation_plans_requirement_fkey")
  assignee       User                      @relation("RemediationPlanAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  proposedByUser User                      @relation("RemediationPlanProposedBy", fields: [proposedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedByUser  User?                     @relation("RemediationPlanDecidedBy", fields: [decidedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId])
  @@index([clientControlId, proposedAt(sort: Desc)], map: "remediation_plans_control_idx")
  @@index([assigneeId])
  @@index([proposedBy])
  @@index([decidedBy])
  @@index([testId])
  @@map("remediation_plans")
  @@schema("tenant")
}

model RequirementApplicabilityRequest {
  id                         String              @id @default(uuid()) @db.Uuid
  tenantId                   String              @map("tenant_id") @db.Uuid
  clientControlRequirementId String              @map("client_control_requirement_id") @db.Uuid
  reason                     String              @db.Text
  status                     ChangeRequestStatus @default(pending)
  requestedBy                String              @map("requested_by") @db.Uuid
  requestedAt                DateTime            @default(now()) @map("requested_at")
  decidedBy                  String?             @map("decided_by") @db.Uuid
  decidedAt                  DateTime?           @map("decided_at")
  decisionReason             String?             @map("decision_reason") @db.Text
  revertedBy                 String?             @map("reverted_by") @db.Uuid
  revertedAt                 DateTime?           @map("reverted_at")
  revertReason               String?             @map("revert_reason") @db.Text
  decidedDirectly            Boolean             @default(false) @map("decided_directly")

  requirement     ClientControlRequirement @relation(fields: [clientControlRequirementId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "requirement_applicability_requests_req_fkey")
  tenant          Company                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedByUser User                     @relation("ApplicabilityRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedByUser   User?                    @relation("ApplicabilityDecidedBy", fields: [decidedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revertedByUser  User?                    @relation("ApplicabilityRevertedBy", fields: [revertedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId])
  @@index([clientControlRequirementId, requestedAt(sort: Desc)], map: "requirement_applicability_requests_req_idx")
  @@index([requestedBy])
  @@index([decidedBy])
  @@map("requirement_applicability_requests")
  @@schema("tenant")
}

model RequirementOccurrence {
  id                         String   @id @default(uuid()) @db.Uuid
  tenantId                   String   @map("tenant_id") @db.Uuid
  clientControlRequirementId String   @map("client_control_requirement_id") @db.Uuid
  occurredOn                 DateTime @map("occurred_on") @db.Date
  description                String   @db.Text
  registeredBy               String   @map("registered_by") @db.Uuid
  registeredAt               DateTime @default(now()) @map("registered_at")

  requirement      ClientControlRequirement @relation(fields: [clientControlRequirementId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "requirement_occurrences_req_fkey")
  tenant           Company                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  registeredByUser User                     @relation("OccurrenceRegisteredBy", fields: [registeredBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submissions      EvidenceSubmission[]

  @@index([tenantId])
  @@index([clientControlRequirementId, occurredOn(sort: Desc)], map: "requirement_occurrences_req_idx")
  @@index([registeredBy])
  @@map("requirement_occurrences")
  @@schema("tenant")
}

model NoOccurrenceDeclaration {
  id                         String    @id @default(uuid()) @db.Uuid
  tenantId                   String    @map("tenant_id") @db.Uuid
  clientControlRequirementId String    @map("client_control_requirement_id") @db.Uuid
  windowStart                DateTime  @map("window_start") @db.Date
  windowEnd                  DateTime  @map("window_end") @db.Date
  note                       String?   @db.Text
  declaredBy                 String    @map("declared_by") @db.Uuid
  declaredAt                 DateTime  @default(now()) @map("declared_at")
  invalidatedAt              DateTime? @map("invalidated_at")

  requirement    ClientControlRequirement @relation(fields: [clientControlRequirementId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "no_occurrence_declarations_req_fkey")
  tenant         Company                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  declaredByUser User                     @relation("NoOccurrenceDeclaredBy", fields: [declaredBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId])
  @@index([clientControlRequirementId, windowStart(sort: Desc)], map: "no_occurrence_declarations_req_idx")
  @@index([declaredBy])
  @@map("no_occurrence_declarations")
  @@schema("tenant")
}

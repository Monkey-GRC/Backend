enum ExecutionOrigin {
  scheduled
  manual

  @@map("execution_origin")

  @@schema("tenant")
}

enum CheckResultStatus {
  passed
  failed
  invalid
  not_applicable
  not_run

  @@map("check_result_status")

  @@schema("tenant")
}

enum ExecutionLogLevel {
  info
  warn
  error

  @@map("execution_log_level")

  @@schema("tenant")
}

model ScheduleRule {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  rule               String // "cada 6 horas"
  appliesTo          String   @map("applies_to")
  affectedAssetCount Int      @map("affected_asset_count")
  nextRunAt          DateTime @map("next_run_at")

  tenant Company @relation(fields: [tenantId], references: [id])

  executions Execution[]

  @@index([tenantId])

  @@map("schedule_rules")
  @@schema("tenant")
}

// Una ejecución fallida es un problema de conexión, no un incumplimiento (§8).
enum ExecutionStatus {
  queued
  running
  completed
  failed
  cancelled

  @@map("execution_status")
  @@schema("tenant")
}

// Qué hace una ejecución (D58). Una validación solo comprueba que se puede acceder a la cuenta del cliente (segundos; el cliente espera en
// pantalla); una evaluación corre el motor (minutos). Corren en carriles distintos del trabajador para que una no bloquee a la otra.
enum ExecutionKind {
  assessment
  validation
  // Crear el agente de la sonda de un servidor (D113): lo hace el trabajador, con una credencial de escritura que nunca está en el backend. Corre en su propio
  // carril corto, como la validación: el cliente espera unos segundos en pantalla.
  enrollment

  @@map("execution_kind")
  @@schema("tenant")
}

model Execution {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  assetId            String          @map("asset_id") @db.Uuid
  scheduleRuleId     String?         @map("schedule_rule_id") @db.Uuid // null si es manual
  retryOfId          String?         @map("retry_of_id") @db.Uuid
  // Desde cuándo espera en la cola (D57). Ordena el reclamo del trabajador.
  queuedAt           DateTime        @default(now()) @map("queued_at")
  // Null mientras está en cola; se fija cuando el trabajador la reclama.
  startedAt          DateTime?       @map("started_at")
  finishedAt         DateTime?       @map("finished_at")
  status             ExecutionStatus
  progressPercentage Int             @default(0) @map("progress_percentage")
  origin             ExecutionOrigin
  kind               ExecutionKind   @default(assessment)
  // Grupo de trabajadores que la atiende (DT-105): el del backend que la creó. Un trabajador solo reclama las de su grupo.
  runnerPool         String          @default("default") @map("runner_pool")
  // Versión del motor y regiones evaluadas (D53). Lo que el motor no devuelve para un check de esta corrida es `not_applicable`,
  // no «no ejecutado»: el conjunto ejecutado es el catálogo de esa versión (D56, DT-50).
  engineVersion      String?         @map("engine_version")
  regions            String[]
  checksExecuted     Int?            @map("checks_executed")
  // Clave i18n de por qué falló (connection.role_not_found, execution.timed_out…). Un fallo de ejecución es de CONEXIÓN, no un incumplimiento.
  failureReason      String?         @map("failure_reason")

  asset        Asset         @relation(fields: [assetId], references: [id])
  scheduleRule ScheduleRule? @relation(fields: [scheduleRuleId], references: [id])
  retryOf      Execution?    @relation("ExecutionRetries", fields: [retryOfId], references: [id])
  retries      Execution[]   @relation("ExecutionRetries")
  tenant       Company       @relation(fields: [tenantId], references: [id])

  checkResults CheckResult[]
  logs         ExecutionLog[]

  @@index([assetId, startedAt])
  @@index([status, queuedAt])
  @@index([tenantId])
  @@index([retryOfId])
  @@index([scheduleRuleId])
  @@map("executions")
  @@schema("tenant")
}

// Dato crudo de una corrida de la sonda. La interpretación vive en evaluations.
model CheckResult {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  executionId String            @map("execution_id") @db.Uuid
  checkId     String            @map("check_id") @db.Uuid
  platform    String
  policyId    String            @map("policy_id")
  rawCheckId  String            @map("raw_check_id")
  result      CheckResultStatus
  evaluatedAt DateTime          @map("evaluated_at")
  // Solo checks de nube (D56, DT-44): el recurso evaluado, su región y lo que el motor dijo. Nulos en los checks de la sonda.
  assetResourceId String?        @map("asset_resource_id") @db.Uuid
  region          String?
  statusDetail    String?        @map("status_detail") @db.Text
  engineSeverity  String?        @map("engine_severity")

  execution     Execution      @relation(fields: [executionId], references: [id])
  check         Check          @relation(fields: [checkId], references: [id])
  assetResource AssetResource? @relation(fields: [assetResourceId], references: [id])
  tenant        Company        @relation(fields: [tenantId], references: [id])

  // Tabla de mayor volumen del sistema (miles de checks por activo por corrida)
  @@index([assetResourceId])
  @@index([executionId])
  @@index([checkId])
  @@index([tenantId])
  @@map("check_results")
  @@schema("tenant")
}

model ExecutionLog {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  executionId String            @map("execution_id") @db.Uuid
  loggedAt    DateTime          @map("logged_at")
  level       ExecutionLogLevel
  message     String            @db.Text

  execution Execution @relation(fields: [executionId], references: [id])
  tenant    Company   @relation(fields: [tenantId], references: [id])

  @@index([executionId, loggedAt])
  @@index([tenantId])
  @@map("execution_logs")
  @@schema("tenant")
}

// pending: pre-registrado y sin conectar · connected / disconnected: lo último que se vio · removed: se quitó el activo y su agente se eliminó de la sonda.
enum AssetAgentStatus {
  pending
  connected
  disconnected
  removed

  @@map("asset_agent_status")
  @@schema("tenant")
}

// El vínculo entre un servidor y su agente en la sonda (D113, cierra DT-32 al construirse). Sin él, un resultado de la sonda no se acepta: es lo que
// impide que un agente de una empresa entregue datos a otra (SEG-45, DT-33). La sonda no aísla a las empresas; lo impone Monkey.
//
// Nombre y grupo del agente en la sonda NO se guardan: son derivados y siempre iguales (nombre = `asset_id`, grupo = `tenant_id`). Se guardan solo
// los hechos. La CLAVE del agente tampoco: sale una sola vez, dentro del comando de instalación.
//
// La fila nace al DECLARAR el servidor, con la versión que el cliente eligió (`sca_policy_id`): de ella sale el sistema operativo (y con él el comando
// de instalación) y qué evaluación se espera. `agent_id` se completa cuando Monkey crea el agente en la sonda, así que hasta entonces es nulo.
model AssetAgent {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  // Un activo, un agente.
  assetId     String           @unique @map("asset_id") @db.Uuid
  // La versión que el cliente declaró («Ubuntu 22.04 LTS»): una política del catálogo. De `sca_policies.os_code` sale linux / windows / macos.
  scaPolicyId String           @map("sca_policy_id") @db.Uuid
  // El identificador del agente en la sonda (`001`, `002`…); nulo hasta que se crea. Único en TODA la base: un mismo agente no puede ser de dos
  // activos, ni de dos empresas.
  agentId     String?          @unique @map("agent_id")
  // La clave del agente, CIFRADA y solo unos minutos: el tiempo justo para entregársela al navegador (D113 punto 4). Se borra al leerla (una sola vez) o al caducar.
  // Nunca se devuelve, nunca va a la bitácora ni a la auditoría.
  installKeyCipher    String?   @map("install_key_cipher")
  installKeyExpiresAt DateTime? @map("install_key_expires_at")
  status      AssetAgentStatus @default(pending)
  registeredAt DateTime        @default(now()) @map("registered_at")
  firstSeenAt DateTime?        @map("first_seen_at")
  lastSeenAt  DateTime?        @map("last_seen_at")
  lastSyncAt  DateTime?        @map("last_sync_at")

  asset     Asset     @relation(fields: [assetId], references: [id])
  tenant    Company   @relation(fields: [tenantId], references: [id])
  scaPolicy ScaPolicy @relation(fields: [scaPolicyId], references: [id])

  @@index([tenantId])
  @@index([scaPolicyId])
  @@map("asset_agents")
  @@schema("tenant")
}

// Un recurso hallado dentro de un activo de nube (D53, D56): el activo es la cuenta/suscripción/proyecto; sus recursos
// (instancias, volúmenes, grupos de seguridad…) cuelgan de él con el identificador del proveedor. Sin esto no se puede
// mostrar el resultado «por activo» ni decir qué recurso falló.
model AssetResource {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  resourceUid  String   @map("resource_uid") // ARN en AWS
  resourceType String   @map("resource_type")
  name         String?
  region       String?
  // Qué clase de activo es para el cliente (servidor, base de datos, almacenamiento, función…) y lo que se supo de él al descubrirlo: sistema
  // operativo, versión, estado… Los atributos son los que el descubrimiento pudo leer; los que no, no están (no se inventan).
  kind         String   @default("other")
  attributes   Json     @default("{}")
  firstSeenAt  DateTime @map("first_seen_at")
  lastSeenAt   DateTime @map("last_seen_at")

  asset  Asset   @relation(fields: [assetId], references: [id])
  tenant Company @relation(fields: [tenantId], references: [id])

  checkResults CheckResult[]
  // El activo del cliente que respalda este recurso, si el descubrimiento lo reconoció (D61).
  childAsset   Asset?       @relation("BackingResource")

  @@unique([assetId, resourceUid])
  @@index([tenantId])
  @@map("asset_resources")
  @@schema("tenant")
}

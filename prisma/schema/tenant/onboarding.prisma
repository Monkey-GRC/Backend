model Service {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  name                  String
  description           String    @db.Text
  scopeStatement        String    @map("scope_statement") @db.Text
  type                  ServiceType
  industriesServed      ServedIndustry[]     @map("industries_served")
  activeClientCount     ActiveClientCount?   @map("active_client_count")
  countries             ServiceCountry[]
  dataTypes             DataType[]           @map("data_types")
  expectedAvailability  ExpectedAvailability @map("expected_availability")
  // Nullable: se captura en el Componente 3 (control técnico), después de declarar el servicio.
  deploymentScenario    DeploymentScenario?  @map("deployment_scenario")
  previousCertification PreviousCertification? @map("previous_certification")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  tenant       Company      @relation(fields: [tenantId], references: [id])

  trustCriteria           ServiceTrustCriterion[]
  frameworks              ServiceFramework[]
  subserviceOrganizations SubserviceOrganization[]
  cuecs                   Cuec[]
  systemDescription       SystemDescription?
  clientRisks             ClientRisk[]
  clientCauses            ClientCause[]
  serviceAssets           ServiceAsset[]
  exclusions              Exclusion[]
  auditObservations       AuditObservation[]
  clientControls ClientControl[]
  clientControlChanges ClientControlChange[]
  evaluations    Evaluation[]

  @@index([tenantId])
  @@index([organizationId])
  @@map("services")
  @@schema("tenant")
}

model ServiceTrustCriterion {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  serviceId        String @map("service_id") @db.Uuid
  trustCriterionId String @map("trust_criterion_id") @db.Uuid

  service        Service        @relation(fields: [serviceId], references: [id])
  trustCriterion TrustCriterion @relation(fields: [trustCriterionId], references: [id])
  tenant         Company        @relation(fields: [tenantId], references: [id])

  @@unique([serviceId, trustCriterionId])
  @@index([tenantId])
  @@index([trustCriterionId])
  @@map("service_trust_criteria")
  @@schema("tenant")
}

model ServiceFramework {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  frameworkId      String   @map("framework_id") @db.Uuid
  serviceId        String   @map("service_id") @db.Uuid
  catalogVersionId String   @map("catalog_version_id") @db.Uuid
  contractedAt     DateTime @map("contracted_at") @db.Date
  status           ServiceFrameworkStatus @default(active)
  evaluationPeriod String   @map("evaluation_period")

  framework      Framework      @relation(fields: [frameworkId], references: [id])
  service        Service        @relation(fields: [serviceId], references: [id])
  catalogVersion CatalogVersion @relation(fields: [catalogVersionId], references: [id])
  tenant         Company        @relation(fields: [tenantId], references: [id])

  assessments FrameworkAssessment[]
  periods     ServiceFrameworkPeriod[]

  @@unique([serviceId, frameworkId])
  @@index([tenantId])
  @@index([catalogVersionId])
  @@index([frameworkId])
  @@map("service_frameworks")
  @@schema("tenant")
}

enum EvaluationPeriodStatus {

  linkUrl   String? @map("link_url")
  fileKey   String? @map("file_key")
  sections  Json

  service Service @relation(fields: [serviceId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])

  @@index([tenantId])

  @@map("system_descriptions")
  @@schema("tenant")
}


model Asset {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  responsibleId      String?                 @map("responsible_id") @db.Uuid
  code               String
  connectionCategory AssetConnectionCategory @map("connection_category")
  type               AssetType
  name               String
  // Etiqueta descriptiva: en un activo descubierto, su sistema operativo o motor (D61).
  platform           String
  // La plataforma que el cliente eligió al conectar (D67). Obligatoria en una conexión; nula en un activo descubierto.
  platformId         String?                 @map("platform_id") @db.Uuid
  ipAddress          String?                 @map("ip_address")
  location           String?
  criticality        AssetCriticality
  tags               Json
  origin             AssetOrigin
  status             AssetStatus             @default(active)
  operationalStatus  AssetOperationalStatus  @default(not_monitored) @map("operational_status")
  technicalCoverage  String                  @map("technical_coverage")
  // Identificador del activo en el proveedor (cuenta de AWS, suscripción de Azure, proyecto de GCP). Solo activos de nube.
  externalAccountId  String?                 @map("external_account_id")
  // Un activo descubierto dentro de una conexión (D61): su cuenta de nube (`parent`) y el recurso técnico que lo respalda (`resource`, 1:1).
  // Los activos que el cliente registra a mano no tienen ninguno de los dos.
  parentAssetId      String?                 @map("parent_asset_id") @db.Uuid
  resourceId         String?                 @unique @map("resource_id") @db.Uuid

  parent       Asset?                   @relation("AssetChildren", fields: [parentAssetId], references: [id])
  children     Asset[]                  @relation("AssetChildren")
  resource     AssetResource?           @relation("BackingResource", fields: [resourceId], references: [id])
  capabilityPlatform CapabilityPlatform? @relation(fields: [platformId], references: [id])
  organization Organization             @relation(fields: [organizationId], references: [id])
  responsible  OrganizationResponsible? @relation(fields: [responsibleId], references: [id])
  tenant       Company                  @relation(fields: [tenantId], references: [id])

  serviceAssets ServiceAsset[]
  exclusions    Exclusion[]
  provisionings AssetProvisioning[]
  evaluations     Evaluation[]
  vulnerabilities Vulnerability[]
  findings        Finding[]
  executions Execution[]
  resources  AssetResource[]
  // El agente de la sonda que mide este servidor (D113). Un activo, un agente.
  agent      AssetAgent?

  @@unique([organizationId, code])
  @@index([tenantId])
  @@index([responsibleId])
  @@index([parentAssetId])
  @@index([platformId])
  @@map("assets")
  @@schema("tenant")
}

model ServiceAsset {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  assetId   String @map("asset_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  asset   Asset   @relation(fields: [assetId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])

  @@unique([assetId, serviceId])
  @@index([tenantId])
  @@index([serviceId])
  @@map("service_assets")
  @@schema("tenant")
}

// Cada cuánto corre la evaluación automática de una conexión (paso "programar", §6.3).
// ac_01 admite every_6h y every_24h; ac_02 a ac_06 son continuous.
enum ScheduleFrequency {
  continuous
  every_6h
  every_24h

  @@map("schedule_frequency")
  @@schema("tenant")
}

// Cómo se conectó el activo (D53): el cliente elige el canal entre los que existen para su categoría y Monkey lo guía.
enum ConnectionMethod {
  agent
  readonly_role
  access_keys
  // GCP (D112): el proyecto del cliente confía en la sesión de AWS de Monkey; sin llaves.
  identity_federation

  @@map("connection_method")
  @@schema("tenant")
}

model AssetProvisioning {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  assetId               String    @map("asset_id") @db.Uuid
  automatedCapabilityId String    @map("automated_capability_id") @db.Uuid
  connectionStatus      ProvisioningStatus @default(pending) @map("connection_status")
  lastValidatedAt       DateTime? @map("last_validated_at")
  technicalCoverage     String    @map("technical_coverage")
  // Nullable: el flujo es conectar → validar → activar → programar, y las conexiones
  // agentless (ac_02) no guardan credenciales.
  encryptedCredentials  String?   @map("encrypted_credentials") @db.Text
  // false al crear: un aprovisionamiento no está activo hasta que se valida la conexión.
  isActive              Boolean   @default(false) @map("is_active")
  // Null hasta el paso "programar".
  scheduleFrequency     ScheduleFrequency? @map("schedule_frequency")
  // Null hasta que se elige el canal. Las regiones son las que el cliente declara y las únicas que se evalúan (D53).
  connectionMethod      ConnectionMethod?  @map("connection_method")
  regions               String[]
  // Lo que el cliente necesita para configurar el rol de solo lectura (D58). Ninguno es secreto: el ExternalId lo genera Monkey y evita que otro
  // cliente use el rol de este; el ARN del rol lo pega el cliente. Las llaves (canal alternativo) siguen cifradas en `encryptedCredentials`.
  externalId            String?            @map("external_id")
  roleArn               String?            @map("role_arn")
  // GCP (D112): el número del proyecto que imprime el script de alta. No es un secreto; el trabajador arma la audiencia de la federación con él.
  projectNumber         String?            @map("project_number")
  // Cuándo se descubrieron por última vez los recursos de la cuenta. Lo que no se vio desde entonces ya no se muestra.
  inventoryAt           DateTime?          @map("inventory_at")
  // Servicios que no se pudieron leer en ese descubrimiento: el cliente ve «incompleto», no «vacío».
  inventoryWarnings     String[]           @map("inventory_warnings")

  asset               Asset              @relation(fields: [assetId], references: [id])
  automatedCapability AutomatedCapability @relation(fields: [automatedCapabilityId], references: [id])
  tenant              Company             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([assetId])
  @@index([automatedCapabilityId])
  @@map("asset_provisionings")
  @@schema("tenant")
}
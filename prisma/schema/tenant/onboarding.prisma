enum ExpectedAvailability {
  h24x7 @map("24x7") // Prisma no permite identificadores que empiecen con dígito; el valor real en BD/wire es "24x7"
  business_hours
  on_demand
  not_applicable

  @@schema("tenant")
}

enum DeploymentScenario {
  cloud_managed_only
  cloud_with_servers
  on_premise
  hybrid

  @@schema("tenant")
}

enum PreviousCertification {
  soc2
  soc1
  iso27001
  none

  @@schema("tenant")
}

model Service {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  name                  String
  description           String    @db.Text
  scopeStatement        String    @map("scope_statement") @db.Text
  type                  ServiceType
  industriesServed      ServedIndustry[]     @map("industries_served")
  activeClientCount     ActiveClientCount?   @map("active_client_count")
  countries             ServiceCountry[]
  dataTypes             DataType[]           @map("data_types")
  expectedAvailability  ExpectedAvailability @map("expected_availability")
  deploymentScenario    DeploymentScenario   @map("deployment_scenario")
  previousCertification PreviousCertification? @map("previous_certification")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  tenant       Company      @relation(fields: [tenantId], references: [id])

  trustCriteria           ServiceTrustCriterion[]
  frameworks              ServiceFramework[]
  subserviceOrganizations SubserviceOrganization[]
  cuecs                   Cuec[]
  systemDescription       SystemDescription?
  serviceRisks            ServiceRisk[]
  scope                   Scope?
  serviceAssets           ServiceAsset[]
  clientControls ClientControl[]
  evaluations    Evaluation[]

  @@map("services")
  @@schema("tenant")
}

model ServiceTrustCriterion {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  serviceId        String @map("service_id") @db.Uuid
  trustCriterionId String @map("trust_criterion_id") @db.Uuid

  service        Service        @relation(fields: [serviceId], references: [id])
  trustCriterion TrustCriterion @relation(fields: [trustCriterionId], references: [id])
  tenant         Company        @relation(fields: [tenantId], references: [id])

  @@unique([serviceId, trustCriterionId])
  @@map("service_trust_criteria")
  @@schema("tenant")
}

model ServiceFramework {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  frameworkId      String   @map("framework_id") @db.Uuid
  serviceId        String   @map("service_id") @db.Uuid
  catalogVersionId String   @map("catalog_version_id") @db.Uuid
  contractedAt     DateTime @map("contracted_at") @db.Date
  status           String   // TODO: enum — no está en contracts/enums.md, confirmar con el comité
  evaluationPeriod String   @map("evaluation_period")

  framework      Framework      @relation(fields: [frameworkId], references: [id])
  service        Service        @relation(fields: [serviceId], references: [id])
  catalogVersion CatalogVersion @relation(fields: [catalogVersionId], references: [id])
  tenant         Company        @relation(fields: [tenantId], references: [id])

  @@map("service_frameworks")
  @@schema("tenant")
}

model SubserviceOrganization {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  serviceId       String                 @map("service_id") @db.Uuid
  provider        String
  serviceProvided String                 @map("service_provided")
  responsibility  String                 @db.Text
  type            SubserviceProviderType

  service Service @relation(fields: [serviceId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])
  csocs   Csoc[]

  @@map("subservice_organizations")
  @@schema("tenant")
}

// No medibles por Monkey (decisión D11): salen de las secciones 7 y 8 de la
// Descripción del Sistema. Existen porque el auditor las pide, no porque
// Monkey las evalúe — por eso no tienen relación hacia evaluations.
model Csoc {
  id                       String @id @default(uuid()) @db.Uuid
  tenantId                 String @map("tenant_id") @db.Uuid
  subserviceOrganizationId String @map("subservice_organization_id") @db.Uuid
  expectedControl          String @map("expected_control") @db.Text

  subserviceOrganization SubserviceOrganization @relation(fields: [subserviceOrganizationId], references: [id])
  tenant                 Company                @relation(fields: [tenantId], references: [id])

  @@map("csocs")
  @@schema("tenant")
}

// No medibles por Monkey (decisión D11) — ver el comentario en Csoc.
model Cuec {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  serviceId       String @map("service_id") @db.Uuid
  expectedControl String @map("expected_control") @db.Text

  service Service @relation(fields: [serviceId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])

  @@map("cuecs")
  @@schema("tenant")
}

model SystemDescription {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  serviceId String @unique @map("service_id") @db.Uuid
  filePath  String @map("file_path")
  sections  Json

  service Service @relation(fields: [serviceId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])

  @@map("system_descriptions")
  @@schema("tenant")
}

model ServiceRisk {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  riskId    String @map("risk_id") @db.Uuid

  service Service @relation(fields: [serviceId], references: [id])
  risk    Risk    @relation(fields: [riskId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])

  @@unique([serviceId, riskId])
  @@map("service_risks")
  @@schema("tenant")
}

model Scope {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  serviceId     String @unique @map("service_id") @db.Uuid
  serverCount   Int    @map("server_count")
  cloudCount    Int    @map("cloud_count")
  appCount      Int    @map("app_count")
  databaseCount Int    @map("database_count")
  endpointCount Int    @map("endpoint_count")

  service Service @relation(fields: [serviceId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])

  @@map("scopes")
  @@schema("tenant")
}

enum AssetConnectionCategory {
  ac_01
  ac_02
  ac_03
  ac_04
  ac_05
  ac_06

  @@schema("tenant")
}

enum AssetOperationalStatus {
  operational
  warning
  error
  not_monitored

  @@schema("tenant")
}

model Asset {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  responsibleId      String?                 @map("responsible_id") @db.Uuid
  code               String
  connectionCategory AssetConnectionCategory @map("connection_category")
  type               String                  // TODO: enum — gana application/documentation/endpoint (D5), no está en contracts/enums.md
  name               String
  platform           String
  ipAddress          String?                 @map("ip_address")
  location           String?
  criticality        String                  // TODO: enum — no está en contracts/enums.md
  tags               Json
  origin             String                  // TODO: enum — no está en contracts/enums.md
  status             String                  // TODO: enum — no está en contracts/enums.md
  operationalStatus  AssetOperationalStatus  @default(not_monitored) @map("operational_status")
  technicalCoverage  String                  @map("technical_coverage")

  organization Organization             @relation(fields: [organizationId], references: [id])
  responsible  OrganizationResponsible? @relation(fields: [responsibleId], references: [id])
  tenant       Company                  @relation(fields: [tenantId], references: [id])

  serviceAssets ServiceAsset[]
  provisionings AssetProvisioning[]
  evaluations     Evaluation[]
  vulnerabilities Vulnerability[]
  findings        Finding[]
  executions Execution[]

  @@map("assets")
  @@schema("tenant")
}

model ServiceAsset {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  assetId   String @map("asset_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  asset   Asset   @relation(fields: [assetId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])

  @@unique([assetId, serviceId])
  @@map("service_assets")
  @@schema("tenant")
}

model AssetProvisioning {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  assetId               String    @map("asset_id") @db.Uuid
  automatedCapabilityId String    @map("automated_capability_id") @db.Uuid
  connectionStatus      String    @map("connection_status") // TODO: enum — conectar→validar→activar→programar, no está en contracts/enums.md
  lastValidatedAt       DateTime? @map("last_validated_at")
  technicalCoverage     String    @map("technical_coverage")
  encryptedCredentials  String    @map("encrypted_credentials") @db.Text
  isActive              Boolean   @default(true) @map("is_active")

  asset               Asset               @relation(fields: [assetId], references: [id])
  automatedCapability AutomatedCapability @relation(fields: [automatedCapabilityId], references: [id])
  tenant              Company             @relation(fields: [tenantId], references: [id])

  @@map("asset_provisionings")
  @@schema("tenant")
}
  @@map("evaluation_period_status")
  @@schema("tenant")
}

enum EvaluationPeriodOrigin {
  user
  system

  @@map("evaluation_period_origin")
  @@schema("tenant")
}

// MD-500, D145, D148 · Un período auditado por fila. Como mucho uno `open` por servicio × marco (índice único parcial en la migración); los `closed` son histórico y no se editan.
model ServiceFrameworkPeriod {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  serviceFrameworkId String                 @map("service_framework_id") @db.Uuid
  periodStart        DateTime               @map("period_start") @db.Date
  periodEnd          DateTime               @map("period_end") @db.Date
  // Nulo = «hoy» (D87); con valor, la fecha de corte congelada.
  cutoffDate         DateTime?              @map("cutoff_date") @db.Date
  status             EvaluationPeriodStatus @default(open)
  openedBy           EvaluationPeriodOrigin @default(user) @map("opened_by")
  closedAt           DateTime?              @map("closed_at")
  createdAt          DateTime               @default(now()) @map("created_at")

  serviceFramework ServiceFramework @relation(fields: [serviceFrameworkId], references: [id])
  tenant           Company          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([serviceFrameworkId])
  @@map("service_framework_periods")
  @@schema("tenant")
}

model SubserviceOrganization {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  serviceId       String                 @map("service_id") @db.Uuid
  // Opcionales: el "detalle" del Excel lo es; solo el tipo es obligatorio (contracts onboarding-service-context).
  provider        String?
  serviceProvided String?                @map("service_provided")
  responsibility  String?                @db.Text
  type            SubserviceProviderType

  service Service @relation(fields: [serviceId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])
  csocs   Csoc[]

  @@index([tenantId])
  @@index([serviceId])
  @@map("subservice_organizations")
  @@schema("tenant")
}

// No medibles por Monkey (decisión D11): salen de las secciones 7 y 8 de la
// Descripción del Sistema. Existen porque el auditor las pide, no porque
// Monkey las evalúe — por eso no tienen relación hacia evaluations.
model Csoc {
  id                       String @id @default(uuid()) @db.Uuid
  tenantId                 String @map("tenant_id") @db.Uuid
  subserviceOrganizationId String @map("subservice_organization_id") @db.Uuid
  expectedControl          String @map("expected_control") @db.Text

  subserviceOrganization SubserviceOrganization @relation(fields: [subserviceOrganizationId], references: [id])
  tenant                 Company                @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([subserviceOrganizationId])
  @@map("csocs")
  @@schema("tenant")
}

// No medibles por Monkey (decisión D11) — ver el comentario en Csoc.
model Cuec {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  serviceId       String @map("service_id") @db.Uuid
  expectedControl String @map("expected_control") @db.Text

  service Service @relation(fields: [serviceId], references: [id])
  tenant  Company @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([serviceId])
  @@map("cuecs")
  @@schema("tenant")
}

model SystemDescription {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  serviceId String @unique @map("service_id") @db.Uuid
  // Dos formas de entregarla (D51): un enlace o un archivo guardado en el almacenamiento. Pueden estar las dos;

model Organization {
  id                     String               @id @default(uuid()) @db.Uuid
  companyId              String               @unique @map("company_id") @db.Uuid
  name                   String
  description            String               @db.Text
  size                   OrganizationSize
  industry               Industry
  businessModel          BusinessModel        @map("business_model")
  yearsInOperation       YearsInOperation?    @map("years_in_operation")
  incorporationCountries IncorporationCountry[] @map("incorporation_countries")
  clientCountries        ClientCountry[]      @map("client_countries")
  complianceMaturity     ComplianceMaturity   @map("compliance_maturity")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  company      Company                   @relation(fields: [companyId], references: [id])
  regulations  OrganizationRegulation[]
  responsibles OrganizationResponsible[]
  services     Service[]
  assets       Asset[]

  @@map("organizations")
  @@schema("tenant")
}

model Regulation {
  id           String @id @default(uuid()) @db.Uuid
  code         String @unique // ley_1581_co, lfpdppp_mx, gdpr_eu... (14 valores, contracts/enums.md)
  name         String
  jurisdiction String

  organizationRegulations OrganizationRegulation[]

  // No se puntúa (D10). Mismo catálogo para todos los clientes → sin tenant_id, en catalog.
  @@map("regulations")
  @@schema("catalog")
}

model OrganizationRegulation {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  regulationId   String @map("regulation_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  regulation   Regulation   @relation(fields: [regulationId], references: [id])
  tenant       Company      @relation(fields: [tenantId], references: [id])

  @@unique([organizationId, regulationId])
  @@index([tenantId])
  @@index([regulationId])
  @@map("organization_regulations")
  @@schema("tenant")
}

model OrganizationResponsible {
  id             String                      @id @default(uuid()) @db.Uuid
  tenantId       String                      @map("tenant_id") @db.Uuid
  organizationId String                      @map("organization_id") @db.Uuid
  type           OrganizationResponsibleType
  personName     String                      @map("person_name")

  organization Organization @relation(fields: [organizationId], references: [id])
  tenant       Company      @relation(fields: [tenantId], references: [id])

  assets Asset[]
  evidenceRequirements EvidenceRequirement[]
  riskTreatments RiskTreatment[]

  // Un mismo cargo con la misma persona no se repite (puede haber varios propietarios de activo, con nombres distintos).
  @@unique([organizationId, type, personName])
  @@index([tenantId])
  @@index([organizationId])
  @@map("organization_responsibles")
  @@schema("tenant")
}


model Reason {
    id              String    @id @default(uuid()) @db.Uuid
    name            String
    description     String?
    code            String    @unique @db.VarChar(10)
    created_at      DateTime  @default(now())
    updated_at      DateTime  @updatedAt
    created_by      String?   @db.Uuid
    created_by_user User?     @relation("mnk_user_created_reasons", fields: [created_by], references: [id], onDelete: NoAction)
    updated_by      String?   @db.Uuid
    updated_by_user User?     @relation("mnk_user_updated_reasons", fields: [updated_by], references: [id], onDelete: NoAction)

    @@map("mnk_reasons")
}

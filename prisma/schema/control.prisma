model Control {
    id          String   @id @default(uuid()) @db.Uuid
    name        String
    description String?
    seq         Int      @unique @default(autoincrement())
    objective   String?
    code        String   @unique @db.VarChar(10)
    created_at  DateTime @default(now())
    updated_at  DateTime @updatedAt
    created_by  String?
    updated_by  String?

    @@map("mnk_controls")
    @@index([seq])
    @@index([code])

}

# Copia este archivo a ".env" (mismo directorio) y completa los valores reales.
# El .env NUNCA debe subirse al repo (ya esta en .gitignore).

# --- DB central (registro de tenants, usuarios MONKEY_ADMIN, biblioteca maestra) ---
CENTRAL_DATABASE_URL="postgresql://user:password@host:5432/monkey_central"
CENTRAL_SHADOW_DATABASE_URL="postgresql://user:password@host:5432/monkey_central_shadow"

# --- DB de referencia/scratch para autorear migraciones del proyecto "tenant" en dev ---
TENANT_MIGRATION_DATABASE_URL="postgresql://user:password@host:5432/monkey_tenant_scratch"
TENANT_MIGRATION_SHADOW_DATABASE_URL="postgresql://user:password@host:5432/monkey_tenant_scratch_shadow"

# --- Conexion administrativa a Postgres para CREATE ROLE / CREATE DATABASE / DROP al aprovisionar cada tenant ---
POSTGRES_ADMIN_URL="postgresql://user:password@host:5432/postgres"

# --- Donde quedan alcanzables las DB fisicas de cada tenant recien aprovisionadas ---
TENANT_DB_HOST="host"
TENANT_DB_PORT=5432
TENANT_DB_SSL=false

# Cifra/descifra la contraseña de cada tenant guardada en mnk_clients.db_password_enc.
# Generar con: openssl rand -base64 32
# NO regenerar en un ambiente con tenants ya aprovisionados sin migrar antes sus
# contraseñas -- quedarian indescifrables y esos tenants perderian acceso a su DB.
TENANT_DB_ENCRYPTION_KEY=""

# --- Catalogo CIS/SOC2 sincronizado por el repo monkey-cis-sync ---
WAZUH_DATABASE_URL="postgresql://user:password@host:6432/prueba_wazuh"

JWT_SECRET=""
JWT_EXPIRES_IN=10800
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN=259200

PORT=3000
NODE_ENV=development

# Opcional -- si se omite, main.ts usa por defecto:
#   http://localhost:4200 (frontend-platform), http://127.0.0.1:4201 y http://localhost:4201 (admin)
# CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4201,http://localhost:4201

# --- Almacenamiento de evidencia (checks manuales) -- S3 o MinIO compatible ---
# Sin configurar: el backend arranca igual, solo falla al intentar subir evidencia.
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

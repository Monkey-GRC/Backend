# Conexiones principales para migraciones - postgres (rol dueño). Solo lo usan Prisma CLI, el deploy y los seeds.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/monkey"
SHADOW_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/monkey_shadow"

# Conexión para PrismaClient - monkey_app RLS (runtime de la app, sujeto a RLS)
APP_DATABASE_URL="postgresql://monkey_app:CHANGE_ME@localhost:5432/monkey"

# Nota: contra un servidor remoto agrega ?sslmode=require a las tres URLs de arriba.

# --- Auth (modelo-datos.md §5.3) ---
# Secreto para firmar el access token. 64 bytes aleatorios; no reutilizar entre ambientes.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=""
# Tiempos en segundos: access token 15 min, 30 min de inactividad, 8 h máximo de sesión.
JWT_ACCESS_EXPIRES_IN=900
SESSION_IDLE_TIMEOUT=1800
SESSION_MAX_DURATION=28800
# Secreto del HMAC con que se guardan refresh tokens y claves de acceso (nunca en claro).
# Generar igual que JWT_SECRET, con otro valor. Cambiarlo invalida todas las sesiones abiertas.
TOKEN_HASH_PEPPER=""

# --- Registro de empresas (contracts/modules/monkey-admin.md) ---
# Vigencia de la clave de acceso en horas. 7 días es el supuesto del contrato (P2b abierta).
ACCESS_KEY_TTL_HOURS=168

# --- Primer admin_monkey (npm run bootstrap:admin, solo donde se crea; ver prisma/seed/README.md) ---
# Crea la empresa interna de Monkey y el primer admin_monkey.
# La contraseña NUNCA va como argumento. Cumple la política de modelo-datos.md §5.3. Dry-run por defecto; -- --apply escribe.
BOOTSTRAP_COMPANY_NAME="Monkey"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_LAST_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# CORS: orígenes permitidos separados por coma (si falta, solo localhost:4200/4201)
CORS_ORIGINS="http://localhost:4200,http://localhost:4201"

# --- Componente 3 (Control Técnico) ---
# Cifrado de las credenciales de los sistemas que el cliente conecta (AES-256-GCM, 32 bytes en base64).
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NO la pierdas ni la cambies: lo ya cifrado dejaría de poder leerse.
CREDENTIALS_ENCRYPTION_KEY=
# Evaluación automática: "simulated" solo en desarrollo/demostración (el backend se niega a arrancar
# con simulated en producción). Vacío o "unavailable": la validación responde "aún no disponible".
# "runner": la validación es REAL y la hace el trabajador (D58): el backend encola la comprobación y espera su resultado; no toca la nube del cliente.
PROBE_MODE=
# La identidad de Monkey que asume el rol del cliente (D58). NO es un secreto: se muestra al cliente para que la ponga como "confiable" en su plantilla.
# En desarrollo, el usuario o rol cuyas llaves usa el trabajador. Debe coincidir con la identidad base del `runner.env`.
MONKEY_AWS_PRINCIPAL_ARN=
# Cuánto espera el cliente la respuesta de "Comprobar conexión" antes de decirle "no disponible" (1-60 s, por defecto 25).
VALIDATION_WAIT_SECONDS=
# Token de servicio del trabajador que ejecuta el motor de nube (D57, SEG-47). Sin él, /internal/runner NO existe (404). Genera uno largo y
# aleatorio (openssl rand -base64 48); no lo reutilices entre ambientes. Esa API solo se alcanza por la red interna de Docker, nunca por el proxy.
RUNNER_TOKEN=
# "true" cuenta en el estado de preparación los vínculos check→prueba que el comité aún no ratificó (desarrollo y demostración). Vacío en producción.
READINESS_INCLUDE_PROPOSED=

# --- Almacenamiento de archivos del cliente (Descripción del Sistema, DT-12) ---
# S3 o compatible (minio). Sin bucket y credenciales la app arranca, pero subir un archivo responde 503.
# Con minio: S3_ENDPOINT=https://<host-de-minio> y S3_FORCE_PATH_STYLE=true. Con AWS S3 basta bucket y región.
S3_ENDPOINT=
# Dónde llega el NAVEGADOR (p. ej. https://storage-dev.monkey360.io). Con él se firman los enlaces de descarga; si backend y navegador ven el mismo host, déjalo vacío.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

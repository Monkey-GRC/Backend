# El CI instala con `npm ci` y las dependencias «peer» incluidas (sin legacy-peer-deps). Este archivo fija lo mismo en local,
# por encima del ~/.npmrc de cada persona: con `legacy-peer-deps=true` el lockfile pierde las peers (react de Prisma Studio)
# y el CI deja de instalar (MD-217). Nada de credenciales aquí.
legacy-peer-deps=false

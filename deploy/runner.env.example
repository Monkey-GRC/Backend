# Entorno del trabajador del motor de nube (D57). En la VPS: /home/ubuntu/monkey-dev/runner.env. Vive en el servidor (el despliegue no lo escribe): se edita con scripts/deploy/set-env.sh y el despliegue lo comprueba con scripts/deploy/check-env.sh.
# SOLO lo que el trabajador necesita. NO copies aquí el .env del backend.

# El mismo valor que RUNNER_TOKEN del .env del backend. Sin él (o distinto), el backend responde 401/404.
RUNNER_TOKEN=
# La imagen del motor, FIJADA por versión o por digest (nunca latest; el trabajador se niega a arrancar). Mejor el digest:
#   toniblyx/prowler@sha256:9dbcc3c9abd71ec6d37610e6a5a2c45279bc6488caf8aaa948a9e8e368622d30  (5.44.0)
ENGINE_IMAGE=

# La identidad BASE con la que el trabajador asume el rol de solo lectura del cliente (MonkeyReadOnly). Solo ella tiene llaves; el motor nunca las
# ve: recibe credenciales temporales de 1 hora. En desarrollo, una cuenta de pruebas; en producción, una identidad propia de Monkey sin llaves (DT-43).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Opcionales (valores por defecto entre paréntesis)
# ENGINE_TIMEOUT_SECONDS=1500   # máx. 1500: el backend cierra por tiempo a los 30 min
# ENGINE_MEMORY_MB=2048
# ENGINE_CPUS=2
# POLL_INTERVAL_SECONDS=5              # carril de evaluaciones
# VALIDATION_POLL_INTERVAL_SECONDS=1   # carril de validaciones (un cliente espera en pantalla)

# --- Servidores con agente: el trabajador lee y crea agentes en la sonda (D112) ---
# Sin SONDA_API_URL el trabajador solo evalua la nube. Si se configura, tiene que quedar completo o no arranca.
# La API de la sonda (sin ruta): https://host:55000
SONDA_API_URL=
# Usuario de SOLO LECTURA (agentes, grupos, configuracion). NO uses un administrador.
SONDA_API_USER=
SONDA_API_PASSWORD=
# Usuario de ALTA (crear y retirar agentes y grupos). Tiene que ser DISTINTO del de lectura.
SONDA_ENROLL_USER=
SONDA_ENROLL_PASSWORD=
# Versiones de la sonda que sabemos leer, por prefijo (p. ej. 4.14). Fuera de la lista, el trabajador se niega a leer.
SONDA_SUPPORTED_VERSIONS=4.14
# El certificado de la sonda, fijado (PEM). Es lo correcto en produccion. Se guarda en la VPS como ~/monkey-dev/runner-secrets/sonda-ca.pem (el compose lo monta en /run/secrets/).
SONDA_CA_FILE=/run/secrets/sonda-ca.pem
# Si el certificado fijado es de otro nombre que la direccion a la que se conecta (la sonda de pruebas usa uno generico de `localhost`), el nombre con el que se verifica.
SONDA_TLS_SERVER_NAME=
# SOLO desarrollo: aceptar cualquier certificado. No se permite en produccion ni junto con SONDA_CA_FILE.
SONDA_TLS_INSECURE=